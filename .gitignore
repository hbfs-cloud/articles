# System
.DS_Store
.venv/
__pycache__/

# Claude MCP — .mcp.json is COMMITTED (shared project MCP servers, OAuth per-user,
# zero token in-file). Only local secret-bearing overrides stay out of git.
claude.config.json

# Video Artifacts (Heavy files)
videos/**/output/
videos/**/audio/*.mp3
videos/**/clips/
videos/**/images/
videos/**/*.webm
videos/**/*.mp4
**/video-*/
videos/public/audio/
.omc/

# Keep script.json and config files
!videos/**/script.json
!videos/**/durations.json
node_modules

# Build output (built by CI)
dist/
_site/
.astro/
mcp/data/cache/
data/.price-cache/
data/.price-cache-1h/
data/.replay-cache/
cache/
# …but DO vendor the self-contained dtx-data bundle's referential cache (universe frozen ticker
# lists) — it is committed via git-lfs so native dtx runs without the sibling systematic-tss repo.
!tools/bin/dtx-data/cache/
!tools/bin/dtx-data/cache/**

# Environment variables (secrets)
.env
.env.local
.env.*
credentials/

# Runtime state (not tracked)
data/signal-monitor-state.json
data/execution-logs/
data/broker-instruments.json

# Trading executor (credentials)
tools/trading-executor/config.json

# Playwright MCP logs
.playwright-mcp/

# Backup history (gen-status-page snapshots)
.backup-history-*/

# Claude temp files
.claude/scheduled_tasks.lock
.claude/scanner-pipeline-map.md
data/scanner-notifications.json
data/substack-drafts/
data/pit-backfill/

# one-time email-grant tokens (secrets, never commit)
data/desk/.email-grant.*
