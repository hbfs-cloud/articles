  "lifecycle": {
    "on_start": [
      {
        "step": "CHECK_MARKET_STATUS",
        "description": "Verify market is open or will open today"
      },
      {
        "step": "SYNC_ACCOUNT",
        "description": "Fetch current account balance, buying power, positions"
      },
      {
        "step": "RECONCILE_POSITIONS",
        "description": "Compare broker positions with expected positions. Alert on discrepancy."
      },
      {
        "step": "CHECK_VIX",
