      },
      {
        "step": "LOG_FILL",
        "description": "Record fill price, time, slippage, fees"
      },
      {
        "step": "CHECK_BREAKEVEN",
        "description": "Start monitoring for breakeven trigger"
      },
      {
        "step": "NOTIFY",
        "channel": "telegram",
        "description": "Send fill notification to Telegram"
      }
    ],
    "on_exit": [
      {
        "step": "CANCEL_REMAINING_EXITS",
        "description": "Cancel the other side (SL if TP hit, TP if SL hit)"
      },
      {
        "step": "LOG_EXIT",
        "description": "Record exit price, P&L, hold time"
      },
      {
        "step": "CHECK_ROTATION",
        "description": "If slot freed, check for pending rotation candidates"
      },
      {
        "step": "UPDATE_PORTFOLIO",
        "description": "Update local portfolio state file"
      }
    ],
    "on_breakeven": [
