        "description": "Send fill notification to Telegram"
      }
    ],
    "on_exit": [
      {
        "step": "CANCEL_REMAINING_EXITS",
        "description": "Cancel the other side (SL if TP hit, TP if SL hit)"
      },
      {
        "step": "LOG_EXIT",
        "description": "Record exit price, P&L, hold time"
      },
      {
        "step": "CHECK_ROTATION",
        "description": "If slot freed, check for pending rotation candidates"
      },
      {
        "step": "UPDATE_PORTFOLIO",
        "description": "Update local portfolio state file"
      }
    ],
    "on_breakeven": [
      {
        "step": "MODIFY_STOP",
        "description": "Move stop loss to entry price (+ spread buffer)"
      },
      {
        "step": "LOG_BREAKEVEN",
        "description": "Record breakeven activation"
      }
    ],
    "on_horizon_expiry": [
      {
        "step": "CLOSE_AT_MARKET",
        "description": "Submit market close order at next open"
      },
      {
        "step": "CANCEL_EXITS",
        "description": "Cancel any pending TP/SL orders for this position"
      }
    ],
    "on_error": [
      {
        "step": "LOG_ERROR",
        "description": "Record error with full context"
      },
      {
        "step": "LOOKUP_HANDLER",
