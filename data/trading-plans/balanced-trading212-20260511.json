      "action": "KEEP_PARTIAL",
      "adjust_exits": true,
      "description": "Keep partial fill. Adjust TP/SL quantities proportionally."
    },
    "ORDER_REJECTED": {
      "action": "LOG_AND_SKIP",
      "log_level": "WARN"
    },
