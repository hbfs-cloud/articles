      },
      {
        "step": "LOG_EXIT",
        "description": "Record exit price, P&L, hold time"
      },
      {
        "step": "CHECK_ROTATION",
        "description": "If slot freed, check for pending rotation candidates"
      },
      {
        "step": "UPDATE_PORTFOLIO",
        "description": "Update local portfolio state file"
      }
    ],
