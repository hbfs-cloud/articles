  "_comment": "Hard rules enforced pre-publish on every scan. Source of truth — NOT editorial. tools/validate-scan.js asserts these against scanner/YYYYMMDD/signals.json before publication.",
  "_updated": "2026-04-14",
  "_provenance": "Encoded from scanner/CLAUDE.md + retrospective learnings (Apr 6 INDO dilution, Mar 27 stop tightness, Mar 13 EU FX headwind, Feb 27 Short Squeeze 0% WR).",
  "strategies": {
    "allowed": [
      "Momentum",
      "Pre-Squeeze",
      "Breakout",
      "Pullback"
    ],
    "forbidden": [
      "Short Squeeze",
      "Trend Follow",
      "Defensive",
      "Defensive Momentum",
      "Defensive Yield",
      "Reversal",
      "Momentum Breakout"
    ],
    "_reason": "Short Squeeze: 0% WR over Feb-Mar (retros). Other forbidden labels = invented variants that bypass sweep optimization."
  },
  "tickers": {
    "min_market_cap_usd": 500000000,
    "min_avg_daily_volume_usd": 10000000,
    "_reason": "Below $500M mcap = dilution + manipulation risk (INDO incident Apr 6). Below $10M ADV = liquidity trap, can't exit at scale."
  },
  "tkl_pool": {
    "_comment": "TKL pool = small/mid-cap momentum. Relaxed thresholds but SAME validation pipeline as top 10 (anti-dilution, earnings, insiders, options, sharia).",
    "min_market_cap_usd": 10000000,
    "min_avg_daily_volume_usd": 2000000,
    "validation_identical_to_main": true,
    "_reason": "TKL targets small-caps by design. $10M mcap floor avoids penny stocks. $2M ADV ensures basic liquidity. All other filters (dilution, earnings ±3d, sharia) apply identically."
  },
  "dilution_blocklist": {
    "_comment": "Underwriters known for serial dilution / toxic financing. Block tickers whose recent 424B/S-3 includes any of these names.",
    "underwriters": [
