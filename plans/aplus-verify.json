{
  "artifact": "data/workflow-runs/aplus/$date/verification.json",
  "waves": [
    {
      "name": "preflight",
      "gate": true,
      "calls": [
        {
          "as": "status",
          "server": "marketdata",
          "tool": "GetStatus",
          "args": {},
          "freshness": {
            "max_age_h": 2,
            "required": true
          },
          "assert": {
            "expected_close": "$refdate"
          }
        }
      ]
    },
    {
      "name": "eliminators",
      "calls": [
        {
          "as": "bars",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "$symbols",
            "end_date": "$refdate",
            "limit": 260,
            "force_async": true
          },
          "freshness": {
            "max_age_h": 24,
            "required": true,
            "expects_close": true
          }
        },
        {
          "as": "fundamentals",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "financials,stats,earnings_quarterly,calendar,analyst_actions",
            "symbols": "$symbols",
            "end_date": "$refdate",
            "force_async": true
          },
          "freshness": {
            "max_age_h": 168,
            "required": true
          }
        },
        {
          "as": "technicals",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "quote,technicals,support_resistance,volume_profile,trading_signals",
            "symbols": "$symbols",
            "end_date": "$refdate",
            "force_async": true
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        },
        {
          "as": "sec_evidence",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "sec_filings,flags",
            "symbols": "$symbols",
            "end_date": "$refdate",
            "days": 365,
            "force_async": true
          },
          "freshness": {
            "max_age_h": 168,
            "required": true
          }
        },
        {
          "as": "corporate_actions",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "news,flags",
            "symbols": "$symbols",
            "end_date": "$refdate",
            "days": 180,
            "force_async": true
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        },
        {
          "as": "insiders",
          "server": "marketdata",
          "tool": "GetInsiderActivity",
          "args": {
            "symbols": "$symbols",
            "days": 90,
            "limit": 100,
            "include_transactions": true
          },
          "freshness": {
            "max_age_h": 96,
            "required": true
          }
        }
      ]
    }
  ]
}
