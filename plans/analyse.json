{
  "artifact": "analyses/$symbol/index.html",
  "waves": [
    {
      "name": "preflight",
      "gate": true,
      "calls": [
        {
          "as": "status",
          "server": "marketdata",
          "tool": "GetStatus",
          "args": {},
          "freshness": {
            "max_age_h": 2,
            "required": true
          },
          "assert": {
            "expected_close": "$refdate"
          }
        }
      ]
    },
    {
      "name": "price-fundamentals",
      "calls": [
        {
          "as": "instrument",
          "server": "marketdata",
          "tool": "GetInstruments",
          "args": {
            "symbols": "$symbol",
            "bars_depth": 260
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        },
        {
          "as": "bars",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "$symbol",
            "end_date": "$refdate",
            "limit": 260
          },
          "freshness": {
            "max_age_h": 24,
            "required": true,
            "expects_close": true
          }
        },
        {
          "as": "fundamentals",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "financials,stats,earnings_quarterly,calendar,analyst_actions",
            "symbols": "$symbol",
            "end_date": "$refdate"
          },
          "freshness": {
            "max_age_h": 168,
            "required": true
          }
        },
        {
          "as": "technicals",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "technicals,support_resistance,volume_profile,trading_signals",
            "symbols": "$symbol",
            "end_date": "$refdate"
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        }
      ]
    },
    {
      "name": "risk-evidence",
      "calls": [
        {
          "as": "sec_evidence",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "sec_filings,flags",
            "symbols": "$symbol",
            "end_date": "$refdate",
            "days": 365
          },
          "freshness": {
            "max_age_h": 168,
            "required": true,
            "note": "Primary anti-dilution input: offerings, ATM, shelf, warrants and convertibles."
          }
        },
        {
          "as": "corporate_actions",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "news,flags",
            "symbols": "$symbol",
            "end_date": "$refdate",
            "days": 180
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        },
        {
          "as": "insiders",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "insider_transactions,institutional_holdings",
            "symbols": "$symbol",
            "end_date": "$refdate",
            "days": 365
          },
          "freshness": {
            "max_age_h": 96,
            "required": true
          }
        },
        {
          "as": "short_squeeze",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "short_interest,ctb,ftd_threshold,dark_pool",
            "symbols": "$symbol",
            "end_date": "$refdate",
            "days": 365
          },
          "freshness": {
            "max_age_h": 168,
            "required": true
          }
        },
        {
          "as": "options",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "unusual_options,max_pain",
            "symbols": "$symbol",
            "end_date": "$refdate"
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        }
      ]
    },
    {
      "name": "context",
      "detached": true,
      "calls": [
        {
          "as": "sentiment",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "sentiment_overall,sentiment_stocktwits,sentiment_reddit,news",
            "symbols": "$symbol",
            "end_date": "$refdate",
            "days": 14
          },
          "freshness": {
            "max_age_h": 24,
            "required": false
          }
        },
        {
          "as": "peers",
          "server": "marketdata",
          "tool": "GetReferentialData",
          "args": {
            "correlated_with": "$symbol"
          },
          "freshness": {
            "max_age_h": 168,
            "required": false
          }
        }
      ]
    }
  ]
}
