{
  "artifact": "data/workflow-runs/squeeze/$date/verify",
  "waves": [
    {
      "name": "preflight",
      "gate": true,
      "calls": [
        {
          "as": "status",
          "server": "marketdata",
          "tool": "GetStatus",
          "args": {},
          "freshness": {
            "max_age_h": 1,
            "required": true
          },
          "assert": {
            "equity_reference_close": "$refdate"
          }
        }
      ]
    },
    {
      "name": "governing-evidence",
      "calls": [
        {
          "as": "ctb_top",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "ctb_top"
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        },
        {
          "as": "short_evidence",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "short_interest,ctb,ftd_threshold",
            "symbols": "$symbols",
            "days": 365,
            "force_async": true
          },
          "freshness": {
            "max_age_h": 168,
            "required": true
          }
        },
        {
          "as": "bars",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "$symbols",
            "limit": 120,
            "force_async": true,
            "as_of_timestamp": "$as_of_timestamp",
            "completion_policy": "completed_only"
          },
          "freshness": {
            "max_age_h": 24,
            "required": true,
            "expects_close": true,
            "asset_calendar": "us_equity_exchange_sessions",
            "expected_completed_end": "$refdate"
          }
        },
        {
          "as": "sec_flags",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "sec_filings,flags",
            "symbols": "$symbols",
            "days": 180,
            "end_date": "$refdate",
            "force_async": true
          },
          "freshness": {
            "max_age_h": 168,
            "required": true
          }
        },
        {
          "as": "earnings_window",
          "server": "marketdata",
          "tool": "GetEarningsCalendarFiltered",
          "args": {
            "days_ahead": 14,
            "include_implied_move": true,
            "symbols": "$symbols"
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        }
      ]
    },
    {
      "name": "optional-flow-context",
      "detached": true,
      "calls": [
        {
          "as": "flow_context",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "unusual_options,dark_pool,max_pain",
            "symbols": "$symbols",
            "force_async": true
          },
          "freshness": {
            "max_age_h": 24,
            "required": false
          }
        }
      ]
    }
  ]
}
