{
  "artifact": "data/workflow-runs/sector-rotation/$date",
  "waves": [
    {
      "name": "preflight",
      "gate": true,
      "calls": [
        {
          "as": "status",
          "server": "marketdata",
          "tool": "GetStatus",
          "args": {},
          "freshness": {
            "max_age_h": 1,
            "required": true
          },
          "assert": {
            "expected_close": "$refdate"
          }
        }
      ]
    },
    {
      "name": "governing-bars-and-risk",
      "calls": [
        {
          "as": "bars_sectors",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "XLK,XLF,XLE,XLV,XLI,XLY,XLP,XLU,XLC,XLRE,XLB",
            "end_date": "$refdate",
            "limit": 130,
            "force_async": true
          },
          "freshness": {
            "max_age_h": 24,
            "required": true,
            "expects_close": true
          }
        },
        {
          "as": "bars_bench",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "SPY,QQQ,IWM,USO,TLT,GLD",
            "end_date": "$refdate",
            "limit": 130,
            "force_async": true
          },
          "freshness": {
            "max_age_h": 24,
            "required": true,
            "expects_close": true
          }
        },
        {
          "as": "correlations",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "SPY,QQQ,IWM,GLD,SLV,TLT,USO",
            "end_date": "$refdate",
            "days": 90,
            "adjusted": true,
            "force_async": true
          },
          "freshness": {
            "max_age_h": 48,
            "required": true,
            "expects_close": true
          }
        }
      ]
    },
    {
      "name": "optional-server-context",
      "detached": true,
      "calls": [
        {
          "as": "rotations_context",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "performance_rotations"
          },
          "freshness": {
            "max_age_h": 24,
            "required": false
          }
        },
        {
          "as": "sectors_ref",
          "server": "marketdata",
          "tool": "GetReferentialData",
          "args": {
            "category": "sector",
            "region": "US"
          },
          "freshness": {
            "max_age_h": 168,
            "required": false
          }
        }
      ]
    }
  ]
}
