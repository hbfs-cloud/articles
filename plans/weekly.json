{
  "artifact": "weekly/$date/index.html",
  "waves": [
    {
      "name": "preflight",
      "gate": true,
      "calls": [
        {
          "as": "status",
          "server": "marketdata",
          "tool": "GetStatus",
          "args": {},
          "freshness": {
            "max_age_h": 2,
            "required": true
          },
          "assert": {
            "expected_close": "$refdate"
          }
        },
        {
          "as": "dtx_health",
          "server": "systematic",
          "tool": "GetHealth",
          "args": {
            "expected_close": "$refdate"
          },
          "freshness": {
            "max_age_h": 2,
            "required": true
          }
        }
      ]
    },
    {
      "name": "week-close",
      "calls": [
        {
          "as": "regime",
          "server": "marketdata",
          "tool": "GetMarketContext",
          "args": {
            "facets": "regime,prediction_markets",
            "horizon_days": 10,
            "limit": 20
          },
          "freshness": {
            "max_age_h": 6,
            "required": true
          }
        },
        {
          "as": "regime_systematic",
          "server": "systematic",
          "tool": "DtxRegime",
          "args": {
            "asof": "$refdate",
            "expected_data_date": "$refdate"
          },
          "freshness": {
            "max_age_h": 6,
            "required": true
          }
        },
        {
          "as": "bars_indices",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "SPY,QQQ,IWM,DIA,GLD,SLV,TLT,USO",
            "end_date": "$refdate",
            "limit": 30
          },
          "freshness": {
            "max_age_h": 72,
            "required": true,
            "expects_close": true
          }
        },
        {
          "as": "bars_sectors",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "XLK,XLB,XLF,XLE,XLV,XLI,XLY,XLP,XLU,XLC,XLRE",
            "end_date": "$refdate",
            "limit": 30
          },
          "freshness": {
            "max_age_h": 72,
            "required": true,
            "expects_close": true
          }
        },
        {
          "as": "bars_crypto",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "IBIT,ETHA,SOLZ",
            "end_date": "$refdate",
            "limit": 30
          },
          "freshness": {
            "max_age_h": 72,
            "required": true,
            "expects_close": true,
            "note": "US-listed crypto proxies aligned to the reference close; stale spot data must never govern publication."
          }
        },
        {
          "as": "correlations",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "SPY,QQQ,IWM,GLD,SLV,TLT,USO",
            "end_date": "$refdate",
            "days": 90,
            "adjusted": true,
            "force_async": true
          },
          "freshness": {
            "max_age_h": 72,
            "required": true,
            "expects_close": true
          }
        }
      ]
    },
    {
      "name": "week-ahead",
      "calls": [
        {
          "as": "earnings_calendar",
          "server": "marketdata",
          "tool": "GetEarningsCalendarFiltered",
          "args": {
            "days_ahead": 7,
            "min_expected_move_pct": 3
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        },
        {
          "as": "economic_events",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "economic_events",
            "days": 10
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        },
        {
          "as": "options_sentiment",
          "server": "marketdata",
          "tool": "OptionsAnalytics",
          "args": {
            "action": "sentiment"
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        },
        {
          "as": "short_interest",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "short_interest",
            "symbols": "IWM,SLV,GLD",
            "end_date": "$refdate",
            "days": 365
          },
          "freshness": {
            "max_age_h": 168,
            "required": true
          }
        }
      ]
    },
    {
      "name": "context-only",
      "detached": true,
      "deadline_ms": 120000,
      "calls": [
        {
          "as": "overview",
          "server": "marketdata",
          "tool": "GetMarketContext",
          "args": {
            "facets": "overview",
            "timeout": 90,
            "analysis_depth": "standard",
            "as_of": "$refdate"
          },
          "freshness": {
            "max_age_h": 6,
            "required": false,
            "note": "Context only; never governs a number, selection or publication decision."
          }
        }
      ]
    }
  ]
}
