{
  "artifact": "data/desk/$date/_socle",
  "socle": true,
  "note": "Required shared snapshot for desk products. Optional context is isolated in a detached wave and cannot govern publication.",
  "waves": [
    {
      "name": "preflight",
      "gate": true,
      "calls": [
        {
          "as": "status",
          "server": "marketdata",
          "tool": "GetStatus",
          "args": {},
          "covers": [
            "status",
            "service_health"
          ],
          "freshness": {
            "max_age_h": 2,
            "required": true
          },
          "assert": {
            "expected_close": "$refdate"
          }
        },
        {
          "as": "dtx_health",
          "server": "systematic",
          "tool": "GetHealth",
          "args": {
            "expected_close": "$refdate"
          },
          "covers": [
            "dtx_health"
          ],
          "freshness": {
            "max_age_h": 2,
            "required": true
          }
        }
      ]
    },
    {
      "name": "governing-snapshot",
      "calls": [
        {
          "as": "regime",
          "server": "marketdata",
          "tool": "GetMarketContext",
          "args": {
            "facets": "regime,prediction_markets",
            "horizon_days": 5
          },
          "covers": [
            "regime",
            "regime_marketdata"
          ],
          "freshness": {
            "max_age_h": 6,
            "required": true
          }
        },
        {
          "as": "regime_systematic",
          "server": "systematic",
          "tool": "DtxRegime",
          "args": {
            "asof": "$refdate",
            "expected_data_date": "$refdate"
          },
          "covers": [
            "regime_systematic"
          ],
          "freshness": {
            "max_age_h": 6,
            "required": true
          }
        },
        {
          "as": "dtx_configs",
          "server": "systematic",
          "tool": "DtxListConfigs",
          "args": {},
          "covers": [
            "dtx_configs"
          ],
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        },
        {
          "as": "bars_indices",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "SPY,QQQ,IWM,DIA,GLD,SLV,TLT,USO",
            "end_date": "$refdate",
            "limit": 130
          },
          "covers": [
            "bars_indices",
            "bars_bench",
            "bench"
          ],
          "freshness": {
            "max_age_h": 24,
            "required": true,
            "expects_close": true
          }
        },
        {
          "as": "bars_sectors",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "XLK,XLF,XLE,XLV,XLI,XLY,XLP,XLU,XLC,XLRE,XLB",
            "end_date": "$refdate",
            "limit": 130
          },
          "covers": [
            "bars_sectors"
          ],
          "freshness": {
            "max_age_h": 24,
            "required": true,
            "expects_close": true
          }
        },
        {
          "as": "bars_crypto",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "BTC-USD,ETH-USD,SOL-USD,XRP-USD",
            "end_date": "$refdate",
            "limit": 130
          },
          "covers": [
            "bars_crypto"
          ],
          "freshness": {
            "max_age_h": 24,
            "required": true,
            "expects_close": true
          }
        },
        {
          "as": "economic_events",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "economic_events",
            "days": 7
          },
          "covers": [
            "economic_events"
          ],
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        },
        {
          "as": "earnings_all_7d",
          "server": "marketdata",
          "tool": "GetEarningsCalendarFiltered",
          "args": {
            "days_ahead": 7
          },
          "covers": [
            "earnings_3d"
          ],
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        },
        {
          "as": "correlations",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "SPY,QQQ,IWM,GLD,SLV,TLT,USO",
            "end_date": "$refdate",
            "days": 90,
            "adjusted": true,
            "force_async": true
          },
          "covers": [
            "correlations"
          ],
          "freshness": {
            "max_age_h": 24,
            "required": true,
            "expects_close": true
          }
        }
      ]
    },
    {
      "name": "optional-context",
      "detached": true,
      "deadline_ms": 120000,
      "calls": [
        {
          "as": "options_sentiment",
          "server": "marketdata",
          "tool": "OptionsAnalytics",
          "args": {
            "action": "sentiment"
          },
          "covers": [
            "options_sentiment"
          ],
          "freshness": {
            "max_age_h": 24,
            "required": false
          }
        },
        {
          "as": "insiders_7d",
          "server": "marketdata",
          "tool": "GetInsiderActivity",
          "args": {
            "days": 7,
            "limit": 25
          },
          "covers": [
            "insiders_7d"
          ],
          "freshness": {
            "max_age_h": 96,
            "required": false
          }
        },
        {
          "as": "sectors_ref",
          "server": "marketdata",
          "tool": "GetReferentialData",
          "args": {
            "category": "sector"
          },
          "covers": [
            "sectors_ref"
          ],
          "freshness": {
            "max_age_h": 168,
            "required": false
          }
        }
      ]
    }
  ]
}
