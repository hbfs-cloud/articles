{
  "artifact": "scanner/$scandate/retro/index.html",
  "waves": [
    {
      "name": "preflight",
      "gate": true,
      "calls": [
        {
          "as": "status",
          "server": "marketdata",
          "tool": "GetStatus",
          "args": {},
          "freshness": {
            "max_age_h": 2,
            "required": true
          },
          "assert": {
            "equity_reference_close": "$refdate",
            "sec_operation": "run_screener_sec_enriched"
          }
        }
      ]
    },
    {
      "name": "execution-truth",
      "calls": [
        {
          "as": "bars_positions",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "$symbols",
            "start_date": "$startdate",
            "limit": 80,
            "force_async": true,
            "as_of_timestamp": "$as_of_timestamp",
            "completion_policy": "completed_only"
          },
          "freshness": {
            "max_age_h": 24,
            "required": true,
            "expects_close": true,
            "note": "Daily envelope only; never used to infer intraday event order.",
            "asset_calendar": "us_equity_exchange_sessions",
            "expected_completed_end": "$refdate"
          }
        },
        {
          "as": "bars_intraday",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_15m",
            "symbols": "$symbols",
            "start_date": "$startdate",
            "end_date": "$refdate",
            "limit": 5000,
            "force_async": true
          },
          "freshness": {
            "max_age_h": 24,
            "required": true,
            "note": "Governing fill/stop/target event ordering over the full measured window."
          }
        },
        {
          "as": "bench",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "SPY,QQQ,IWM",
            "start_date": "$startdate",
            "limit": 80,
            "force_async": true,
            "as_of_timestamp": "$as_of_timestamp",
            "completion_policy": "completed_only"
          },
          "freshness": {
            "max_age_h": 24,
            "required": true,
            "expects_close": true,
            "asset_calendar": "us_equity_exchange_sessions",
            "expected_completed_end": "$refdate"
          }
        }
      ]
    },
    {
      "name": "missed-risks",
      "calls": [
        {
          "as": "sec_evidence",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "sec_filings,flags",
            "symbols": "$symbols",
            "start_date": "$startdate",
            "end_date": "$refdate",
            "days": 365,
            "force_async": true
          },
          "freshness": {
            "max_age_h": 168,
            "required": true
          }
        },
        {
          "as": "events",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "calendar,news,analyst_actions",
            "symbols": "$symbols",
            "start_date": "$startdate",
            "end_date": "$refdate",
            "force_async": true
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        },
        {
          "as": "insiders",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "insider_transactions",
            "symbols": "$symbols",
            "start_date": "$startdate",
            "end_date": "$refdate",
            "days": 365,
            "force_async": true
          },
          "freshness": {
            "max_age_h": 96,
            "required": true
          }
        }
      ]
    }
  ]
}
