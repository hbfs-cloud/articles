{
  "artifact": "scanner/retrospective/$rundate/index.html",
  "waves": [
    {
      "name": "preflight",
      "gate": true,
      "calls": [
        {
          "as": "status",
          "server": "marketdata",
          "tool": "GetStatus",
          "args": {},
          "freshness": {
            "max_age_h": 2,
            "required": true
          },
          "assert": {
            "covers_close": "$refdate"
          }
        }
      ]
    },
    {
      "name": "execution-truth",
      "calls": [
        {
          "as": "bars_positions",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "$us_symbols",
            "start_date": "$startdate",
            "limit": 80,
            "force_async": true,
            "as_of_timestamp": "$as_of_timestamp",
            "completion_policy": "completed_only"
          },
          "freshness": {
            "max_age_h": 24,
            "required": true,
            "expects_close": true,
            "note": "Daily envelope only; never used to infer intraday event order.",
            "asset_calendar": "us_equity_exchange_sessions",
            "expected_completed_end": "$refdate"
          }
        },
        {
          "as": "bars_intraday",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_15m",
            "symbols": "$us_symbols",
            "start_date": "$startdate",
            "end_date": "$refdate",
            "limit": 20000,
            "force_async": true
          },
          "freshness": {
            "max_age_h": 24,
            "required": true,
            "note": "Governing fill/stop/target event ordering over the full measured window."
          }
        },
        {
          "as": "bench",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "SPY,QQQ,IWM",
            "start_date": "$startdate",
            "limit": 80,
            "force_async": true,
            "as_of_timestamp": "$as_of_timestamp",
            "completion_policy": "completed_only"
          },
          "freshness": {
            "max_age_h": 24,
            "required": true,
            "expects_close": true,
            "asset_calendar": "us_equity_exchange_sessions",
            "expected_completed_end": "$refdate"
          }
        }
      ]
    },
    {
      "name": "current-risk-corpus",
      "detached": true,
      "calls": [
        {
          "as": "sec_evidence_current",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "sec_filings,flags",
            "symbols": "$symbols",
            "days": 365,
            "force_async": true
          },
          "freshness": {
            "max_age_h": 168,
            "required": false,
            "note": "Current corpus only: sec_filings is not a historical point-in-time source. It may identify accepted-date-attributed risks only and never governs fills, outcomes, or selection knowledge."
          }
        },
        {
          "as": "events_current",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "calendar,news,analyst_actions",
            "symbols": "$symbols",
            "force_async": true
          },
          "freshness": {
            "max_age_h": 24,
            "required": false,
            "note": "Current corpus only: event/news/analyst records require an explicit record-level accepted or published date before they may be described as a dated risk; they are not point-in-time execution evidence."
          }
        },
        {
          "as": "insiders_current",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "insider_transactions",
            "symbols": "$symbols",
            "days": 365,
            "force_async": true
          },
          "freshness": {
            "max_age_h": 96,
            "required": false,
            "note": "Current corpus only: issuer transaction records may be dated for risk context but are not historical snapshots and cannot change execution truth."
          }
        }
      ]
    }
  ]
}
