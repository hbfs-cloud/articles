{
  "artifact": "scanner/$date/data.json",
  "waves": [
    {
      "name": "preflight",
      "gate": true,
      "calls": [
        {
          "as": "status",
          "server": "marketdata",
          "tool": "GetStatus",
          "args": {},
          "freshness": {
            "max_age_h": 2,
            "required": true
          },
          "assert": {
            "equity_reference_close": "$refdate",
            "expected_intraday_close": "$refdate"
          }
        },
        {
          "as": "dtx_health",
          "server": "systematic",
          "tool": "GetHealth",
          "args": {
            "expected_close": "$refdate"
          },
          "freshness": {
            "max_age_h": 2,
            "required": true
          }
        }
      ]
    },
    {
      "name": "vivier-context",
      "calls": [
        {
          "as": "regime_marketdata",
          "server": "marketdata",
          "tool": "GetMarketContext",
          "args": {
            "facets": "regime,prediction_markets",
            "horizon_days": 5
          },
          "freshness": {
            "max_age_h": 6,
            "required": true
          }
        },
        {
          "as": "regime_systematic",
          "server": "systematic",
          "tool": "DtxRegime",
          "args": {
            "asof": "$refdate",
            "expected_data_date": "$refdate"
          },
          "freshness": {
            "max_age_h": 48,
            "required": true
          }
        },
        {
          "as": "dtx_configs",
          "server": "systematic",
          "tool": "DtxListConfigs",
          "args": {},
          "freshness": {
            "max_age_h": 168,
            "required": true
          }
        }
      ]
    },
    {
      "name": "vivier-autoscreen-etf",
      "calls": [
        {
          "as": "autoscreen_etf",
          "server": "marketdata",
          "tool": "RunAutoScreener",
          "args": {
            "region": "US",
            "asset": "etf",
            "top_k": 30,
            "force_async": true
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          },
          "cache_minutes": 180
        }
      ]
    },
    {
      "name": "vivier-momentum",
      "calls": [
        {
          "as": "screen_momentum_us",
          "server": "marketdata",
          "tool": "RunScreener",
          "args": {
            "pass_expr": "rsi14 > 53 && rsi14 < 70 && macd > 0 && vol > 1500000 && close > 10",
            "score_expr": "rsi14 + (macd > 0 ? 15 : 0)",
            "region": "US",
            "asset": "stock",
            "top_k": 40,
            "force_async": true
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        }
      ]
    },
    {
      "name": "vivier-breakout",
      "calls": [
        {
          "as": "screen_breakout_us",
          "server": "marketdata",
          "tool": "RunScreener",
          "args": {
            "pass_expr": "near_breakout(0.03) && vol > 1500000 && rsi14 > 52 && rsi14 < 72 && close > 10",
            "score_expr": "rsi14 + (vol_spike45(1.5) ? 20 : 0)",
            "region": "US",
            "asset": "stock",
            "top_k": 40,
            "force_async": true
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        }
      ]
    },
    {
      "name": "vivier-pullback",
      "calls": [
        {
          "as": "screen_pullback_us",
          "server": "marketdata",
          "tool": "RunScreener",
          "args": {
            "pass_expr": "rsi14 > 40 && rsi14 < 65 && ema(close,20) > ema(close,50) && atr() / close < 0.025 && vol > 1500000 && close > 10",
            "score_expr": "trend_strength(20) * 10 + (65 - rsi14)",
            "region": "US",
            "asset": "stock",
            "top_k": 25,
            "force_async": true
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        }
      ]
    },
    {
      "name": "vivier-events",
      "calls": [
        {
          "as": "earnings_7d",
          "server": "marketdata",
          "tool": "GetEarningsCalendarFiltered",
          "args": {
            "days_ahead": 7,
            "min_expected_move_pct": 4
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        },
        {
          "as": "economic_events",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "economic_events",
            "days": 7
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        }
      ]
    },
    {
      "name": "contexte-detache",
      "detached": true,
      "deadline_ms": 120000,
      "calls": [
        {
          "as": "overview",
          "server": "marketdata",
          "tool": "GetMarketContext",
          "args": {
            "facets": "overview",
            "timeout": 90,
            "analysis_depth": "standard",
            "as_of": "$refdate"
          },
          "freshness": {
            "max_age_h": 6,
            "required": false,
            "note": "CONTEXTE, non requis — appel instable (63s→298s→2 timeouts serveur le 11/08). Son absence ne doit jamais bloquer une publication : il ne sert à aucune sélection."
          }
        },
        {
          "as": "insiders_7d",
          "server": "marketdata",
          "tool": "GetInsiderActivity",
          "args": {
            "days": 7,
            "limit": 25
          },
          "freshness": {
            "max_age_h": 96,
            "required": false
          }
        }
      ]
    }
  ]
}
