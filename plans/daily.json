{
  "artifact": "daily/$date/index.html",
  "waves": [
    {
      "name": "marche",
      "calls": [
        {
          "as": "status",
          "server": "marketdata",
          "tool": "GetStatus",
          "args": {},
          "freshness": {
            "max_age_h": 6,
            "required": true
          }
        },
        {
          "as": "regime",
          "server": "marketdata",
          "tool": "GetMarketContext",
          "args": {
            "facets": "regime,prediction_markets",
            "model": "ensemble",
            "horizon_days": 5
          },
          "freshness": {
            "max_age_h": 6,
            "required": true
          }
        },
        {
          "as": "overview",
          "server": "marketdata",
          "tool": "GetMarketContext",
          "args": {
            "facets": "overview",
            "timeout": 90,
            "analysis_depth": "standard"
          },
          "freshness": {
            "max_age_h": 6,
            "required": false,
            "note": "CONTEXTE, non requis — appel instable (63s→298s→2 timeouts serveur le 11/08). Son absence ne doit jamais bloquer une publication : il ne sert à aucune sélection."
          }
        },
        {
          "as": "regime_systematic",
          "server": "systematic",
          "tool": "DtxRegime",
          "args": {
            "asof": "$refdate",
            "expected_data_date": "$refdate"
          },
          "freshness": {
            "max_age_h": 48,
            "required": true
          }
        },
        {
          "as": "bars_indices",
