{
  "artifact": "daily/$date/index.html",
  "waves": [
    { "name": "marche", "calls": [
      { "as": "status", "server": "marketdata", "tool": "GetStatus", "args": {}, "freshness": { "max_age_h": 6, "required": true } },
      { "as": "regime", "server": "marketdata", "tool": "GetMarketContext", "args": { "facets": "regime,prediction_markets", "model": "ensemble", "horizon_days": 5 }, "freshness": { "max_age_h": 6, "required": true } },
      { "as": "overview", "server": "marketdata", "tool": "GetMarketContext", "args": { "facets": "overview", "timeout": 90, "analysis_depth": "standard" }, "freshness": { "max_age_h": 6, "required": true } },
      { "as": "regime_systematic", "server": "systematic", "tool": "DtxRegime", "args": { "asof": "$refdate", "expected_data_date": "$refdate" }, "freshness": { "max_age_h": 48, "required": true } },
      { "as": "bars_indices", "server": "marketdata", "tool": "QueryData", "args": { "types": "bars_daily", "symbols": "SPY,QQQ,IWM,DIA,GLD,SLV,TLT,USO", "end_date": "$refdate", "limit": 12 }, "freshness": { "max_age_h": 24, "required": true } },
      { "as": "bars_sectors", "server": "marketdata", "tool": "QueryData", "args": { "types": "bars_daily", "symbols": "XLK,XLF,XLE,XLV,XLI,XLY,XLP,XLU,XLC,XLRE", "end_date": "$refdate", "limit": 25 }, "freshness": { "max_age_h": 24, "required": true } },
      { "as": "bars_crypto", "server": "marketdata", "tool": "QueryData", "args": { "types": "bars_daily", "symbols": "BTC-USD,ETH-USD,SOL-USD,XRP-USD", "end_date": "$refdate", "limit": 12 }, "freshness": { "max_age_h": 24, "required": true } },
      { "as": "earnings_today", "server": "marketdata", "tool": "GetEarningsCalendarFiltered", "args": { "days_ahead": 2, "min_market_cap_usd": 10000000000 }, "freshness": { "max_age_h": 24, "required": true } },
      { "as": "economic_events", "server": "marketdata", "tool": "QueryData", "args": { "types": "economic_events", "days": 5 }, "freshness": { "max_age_h": 24, "required": true } },
      { "as": "options_sentiment", "server": "marketdata", "tool": "OptionsAnalytics", "args": { "action": "sentiment" }, "freshness": { "max_age_h": 24, "required": false } }
    ] }
  ]
}
