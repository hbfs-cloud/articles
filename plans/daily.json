{
  "artifact": "daily/$date/index.html",
  "waves": [
    {
      "name": "preflight",
      "gate": true,
      "calls": [
        {
          "as": "status",
          "server": "marketdata",
          "tool": "GetStatus",
          "args": {},
          "freshness": {
            "max_age_h": 2,
            "required": true
          },
          "assert": {
            "expected_close": "$refdate"
          }
        },
        {
          "as": "dtx_health",
          "server": "systematic",
          "tool": "GetHealth",
          "args": {
            "expected_close": "$refdate"
          },
          "freshness": {
            "max_age_h": 2,
            "required": true
          }
        }
      ]
    },
    {
      "name": "market-close",
      "calls": [
        {
          "as": "regime",
          "server": "marketdata",
          "tool": "GetMarketContext",
          "args": {
            "facets": "regime,prediction_markets",
            "horizon_days": 5
          },
          "freshness": {
            "max_age_h": 6,
            "required": true
          }
        },
        {
          "as": "regime_systematic",
          "server": "systematic",
          "tool": "DtxRegime",
          "args": {
            "asof": "$refdate",
            "expected_data_date": "$refdate"
          },
          "freshness": {
            "max_age_h": 6,
            "required": true
          }
        },
        {
          "as": "bars_indices",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "SPY,QQQ,IWM,DIA,GLD,SLV,TLT,USO",
            "end_date": "$refdate",
            "limit": 15
          },
          "freshness": {
            "max_age_h": 24,
            "required": true,
            "expects_close": true
          }
        },
        {
          "as": "bars_sectors",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "XLK,XLB,XLF,XLE,XLV,XLI,XLY,XLP,XLU,XLC,XLRE",
            "end_date": "$refdate",
            "limit": 25
          },
          "freshness": {
            "max_age_h": 24,
            "required": true,
            "expects_close": true
          }
        },
        {
          "as": "bars_crypto",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "BTC-USD,ETH-USD,SOL-USD,XRP-USD",
            "end_date": "$refdate",
            "limit": 15
          },
          "freshness": {
            "max_age_h": 24,
            "required": true,
            "expects_close": true
          }
        }
      ]
    },
    {
      "name": "events-flows",
      "calls": [
        {
          "as": "earnings_today",
          "server": "marketdata",
          "tool": "GetEarningsCalendarFiltered",
          "args": {
            "days_ahead": 2,
            "min_market_cap_usd": 10000000000
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        },
        {
          "as": "economic_events",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "economic_events",
            "days": 5
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        },
        {
          "as": "options_sentiment",
          "server": "marketdata",
          "tool": "OptionsAnalytics",
          "args": {
            "action": "sentiment"
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        },
        {
          "as": "insiders_3d",
          "server": "marketdata",
          "tool": "GetInsiderActivity",
          "args": {
            "days": 3,
            "limit": 25,
            "max_symbols": 100
          },
          "freshness": {
            "max_age_h": 96,
            "required": true
          }
        }
      ]
    },
    {
      "name": "context-only",
      "detached": true,
      "deadline_ms": 120000,
      "calls": [
        {
          "as": "overview",
          "server": "marketdata",
          "tool": "GetMarketContext",
          "args": {
            "facets": "overview",
            "timeout": 90,
            "analysis_depth": "standard",
            "as_of": "$refdate"
          },
          "freshness": {
            "max_age_h": 6,
            "required": false,
            "note": "Context only; never governs a number, selection or publication decision."
          }
        }
      ]
    }
  ]
}
