            "symbols": "SPY,QQQ,IWM,DIA,GLD,SLV,TLT,USO",
            "end_date": "$refdate",
            "limit": 12
          },
          "freshness": {
            "max_age_h": 24,
            "required": true,
            "expects_close": true
          }
        },
        {
          "as": "bars_sectors",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
