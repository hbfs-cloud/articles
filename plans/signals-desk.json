{
  "artifact": "data/workflow-runs/signals-desk/$date/candidates.json",
  "waves": [
    {
      "name": "preflight",
      "gate": true,
      "calls": [
        {
          "as": "status",
          "server": "marketdata",
          "tool": "GetStatus",
          "args": {},
          "freshness": {
            "max_age_h": 2,
            "required": true
          },
          "assert": {
            "expected_close": "$refdate"
          }
        }
      ]
    },
    {
      "name": "context-universe",
      "calls": [
        {
          "as": "regime",
          "server": "marketdata",
          "tool": "GetMarketContext",
          "args": {
            "facets": "regime,prediction_markets",
            "horizon_days": 5
          },
          "freshness": {
            "max_age_h": 6,
            "required": true
          }
        },
        {
          "as": "bars_benchmarks",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "SPY,QQQ,IWM,GLD,TLT",
            "end_date": "$refdate",
            "limit": 30
          },
          "freshness": {
            "max_age_h": 24,
            "required": true,
            "expects_close": true
          }
        },
        {
          "as": "screen_swing",
          "server": "marketdata",
          "tool": "RunScreener",
          "args": {
            "pass_expr": "market_cap > 2000000000 && avg_volume > 1000000 && close > 10 && near_breakout(0.03) && rsi14 > 45 && rsi14 < 68",
            "score_expr": "trend_strength(20) * 10 + (68 - rsi14)",
            "region": "US",
            "asset": "stock",
            "as_of": "$refdate",
            "top_k": 40,
            "force_async": true
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        },
        {
          "as": "screen_pullback",
          "server": "marketdata",
          "tool": "RunScreener",
          "args": {
            "pass_expr": "market_cap > 2000000000 && avg_volume > 1000000 && close > 10 && ema(close,20) > ema(close,50) && close > ema(close,20) * 0.97 && close < ema(close,20) * 1.02 && rsi14 > 45 && rsi14 < 63",
            "score_expr": "trend_strength(20) * 10 + (63 - rsi14)",
            "region": "US",
            "asset": "stock",
            "as_of": "$refdate",
            "top_k": 40,
            "force_async": true
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        },
        {
          "as": "economic_events",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "economic_events",
            "days": 5
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        },
        {
          "as": "earnings_12d",
          "server": "marketdata",
          "tool": "GetEarningsCalendarFiltered",
          "args": {
            "days_ahead": 12
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        }
      ]
    }
  ]
}
