{
  "artifact": "analyses/$symbol/index.html",
  "waves": [
    {
      "name": "preflight",
      "gate": true,
      "calls": [
        {
          "as": "status",
          "server": "marketdata",
          "tool": "GetStatus",
          "args": {},
          "freshness": {
            "max_age_h": 2,
            "required": true
          },
          "assert": {
            "equity_reference_close": "$refdate"
          }
        }
      ]
    },
    {
      "name": "live-session",
      "calls": [
        {
          "as": "quotes_live",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "quote",
            "symbols": "$symbols",
            "force_async": true
          },
          "freshness": {
            "max_age_h": 1,
            "required": true
          },
          "note": "Instantané en séance pour la section « Séance en cours » d'une fiche publiée avant la clôture (décision du propriétaire du 2026-11-02, fiche MRVL). Variations du fournisseur depuis la clôture précédente certifiée ($refdate) ; aucune clôture du jour n'est affirmée et aucun niveau du plan n'en dérive."
        }
      ]
    }
  ]
}
