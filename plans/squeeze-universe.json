{
  "artifact": "data/workflow-runs/squeeze/$date/universe",
  "waves": [
    {
      "name": "preflight",
      "gate": true,
      "calls": [
        {
          "as": "status",
          "server": "marketdata",
          "tool": "GetStatus",
          "args": {},
          "freshness": {
            "max_age_h": 1,
            "required": true
          },
          "assert": {
            "expected_close": "$refdate"
          }
        }
      ]
    },
    {
      "name": "us-universe",
      "calls": [
        {
          "as": "autoscreen_squeeze_us",
          "server": "marketdata",
          "tool": "RunAutoScreener",
          "args": {
            "region": "US",
            "asset": "stock",
            "as_of": "$refdate",
            "force_async": true,
            "min_market_cap": 300000000,
            "min_avg_volume": 1000000,
            "max_rsi": 100,
            "top_k": 120
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        }
      ]
    }
  ]
}
