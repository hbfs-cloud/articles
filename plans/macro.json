{
  "artifact": "data/workflow-runs/macro-event/$date",
  "waves": [
    {
      "name": "preflight",
      "gate": true,
      "calls": [
        {
          "as": "status",
          "server": "marketdata",
          "tool": "GetStatus",
          "args": {},
          "freshness": {
            "max_age_h": 1,
            "required": true
          },
          "assert": {
            "expected_close": "$refdate"
          }
        }
      ]
    },
    {
      "name": "governing-event-and-bars",
      "calls": [
        {
          "as": "economic_events",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "economic_events",
            "days": 10
          },
          "freshness": {
            "max_age_h": 24,
            "required": true
          }
        },
        {
          "as": "bars_macro",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "bars_daily",
            "symbols": "TLT,IEF,UUP,GLD,USO,HYG,LQD",
            "end_date": "$refdate",
            "limit": 90,
            "force_async": true
          },
          "freshness": {
            "max_age_h": 24,
            "required": true,
            "expects_close": true
          }
        }
      ]
    },
    {
      "name": "optional-live-context",
      "detached": true,
      "calls": [
        {
          "as": "rates_context",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "rates",
            "days": 30
          },
          "freshness": {
            "max_age_h": 24,
            "required": false
          }
        },
        {
          "as": "currencies_context",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "currencies"
          },
          "freshness": {
            "max_age_h": 24,
            "required": false
          }
        },
        {
          "as": "commodities_context",
          "server": "marketdata",
          "tool": "QueryData",
          "args": {
            "types": "commodities"
          },
          "freshness": {
            "max_age_h": 24,
            "required": false
          }
        },
        {
          "as": "prediction_markets_context",
          "server": "marketdata",
          "tool": "GetMarketContext",
          "args": {
            "facets": "prediction_markets"
          },
          "freshness": {
            "max_age_h": 24,
            "required": false
          }
        }
      ]
    }
  ]
}
