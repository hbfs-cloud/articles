{
  "artifact": "scanner/$date/_dtx",
  "note": "The public scanner consumes the deployed best book. DtxListConfigs remains a blocking runtime check so a catalog change cannot pass silently.",
  "waves": [
    {
      "name": "preflight",
      "gate": true,
      "calls": [
        { "as": "dtx_health", "server": "systematic", "tool": "GetHealth", "args": { "expected_close": "$refdate" }, "freshness": { "max_age_h": 2, "required": true } }
      ]
    },
    {
      "name": "catalog",
      "gate": true,
      "calls": [
        { "as": "dtx_configs", "server": "systematic", "tool": "DtxListConfigs", "args": {}, "assert": { "contains_portfolio": "best" }, "freshness": { "max_age_h": 24, "required": true } }
      ]
    },
    {
      "name": "decision-replay",
      "calls": [
        {
          "as": "decide_best",
          "server": "systematic",
          "tool": "DtxDecide",
          "args": {
            "portfolio": "best",
            "broker": "alpaca",
            "asof": "$asof",
            "appel": "evening",
            "broker": "alpaca",
            "expected_data_date": "$refdate",
            "request_id": "$request_id",
            "consumer_capabilities": {
              "contract_version": "2.0",
              "opportunity_groups": true,
              "per_candidate_symbol": true,
              "durable_intraday_execution": true
            },
            "positions": [],
            "orders": [],
            "balances": { "base_currency": "USD", "cash_by_currency": { "USD": 100000 }, "total_equity": 100000, "broker_source": "alpaca" }
          },
          "job_max_ms": 900000,
          "freshness": { "max_age_h": 24, "required": true }
        },
        {
          "as": "replay_best",
          "server": "systematic",
          "tool": "DtxReplay",
          "args": { "portfolio": "best", "from": "2021-01-01", "to": "$refdate", "equity_full": true },
          "job_max_ms": 900000,
          "freshness": { "max_age_h": 168, "required": true }
        }
      ]
    }
  ]
}
