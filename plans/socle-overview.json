{
  "artifact": "data/desk/$date/_socle_overview",
  "socle": true,
  "note": "Optional prose-only overview. Numerical claims and selection may not depend on it.",
  "waves": [
    {
      "name": "preflight",
      "gate": true,
      "calls": [
        {
          "as": "status",
          "server": "marketdata",
          "tool": "GetStatus",
          "args": {},
          "freshness": {
            "max_age_h": 2,
            "required": true
          },
          "assert": {
            "equity_reference_close": "$refdate"
          }
        }
      ]
    },
    {
      "name": "overview",
      "detached": true,
      "deadline_ms": 120000,
      "calls": [
        {
          "as": "overview",
          "server": "marketdata",
          "tool": "GetMarketContext",
          "args": {
            "facets": "overview",
            "timeout": 90,
            "analysis_depth": "standard",
            "as_of": "$refdate"
          },
          "covers": [
            "overview"
          ],
          "cache_minutes": 90,
          "freshness": {
            "max_age_h": 6,
            "required": false,
            "note": "Context only; never governs a number, selection or publication decision."
          }
        }
      ]
    }
  ]
}
