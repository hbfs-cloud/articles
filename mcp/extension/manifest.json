{
  "manifest_version": 3,
  "name": "Market Watch MCP",
  "version": "1.0.0",
  "description": "Trading companion — real-time data, alerts, AI analysis via Market Watch MCP",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://finance.yahoo.com/*",
    "https://www.sec.gov/cgi-bin/browse-edgar*",
    "https://stocktwits.com/*",
    "https://www.reddit.com/r/wallstreetbets/*",
    "https://www.reddit.com/r/stocks/*",
    "https://chat.deepseek.com/*",
    "https://finviz.com/*",
    "https://www.finviz.com/*",
    "https://www.tradingview.com/*",
    "https://api.binance.com/*",
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Market Watch MCP"
  },
  "content_scripts": [
    {
      "matches": ["https://finance.yahoo.com/*"],
      "js": ["content/yahoo.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://stocktwits.com/*"],
      "js": ["content/stocktwits.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.reddit.com/r/wallstreetbets/*",
        "https://www.reddit.com/r/stocks/*"
      ],
      "js": ["content/reddit.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content/deepseek.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://finviz.com/*",
        "https://www.finviz.com/*"
      ],
      "js": ["content/finviz.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.tradingview.com/*"],
      "js": ["content/tradingview.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "content/overlay.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
