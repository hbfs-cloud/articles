{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://articles.dailytickers.com/schemas/analysis.json",
  "title": "DailyTickers Ticker Analysis",
  "description": "Structured data for a single ticker analysis. Rendered to HTML by tools/render-analysis.js.",
  "type": "object",
  "required": ["meta", "header", "verdict", "business", "fundamentals", "technicals", "risks", "tradeIdea"],
  "additionalProperties": false,
  "properties": {

    "meta": {
      "type": "object",
      "required": ["lang", "tags", "grade", "date"],
      "additionalProperties": false,
      "properties": {
        "lang":        { "type": "string", "enum": ["en", "fr", "ar"], "default": "en" },
        "dir":         { "type": "string", "enum": ["ltr", "rtl"], "default": "ltr" },
        "level":       { "type": "string", "enum": ["beginner", "intermediate", "expert"], "default": "intermediate" },
        "tags":        { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "grade":       { "type": "string", "enum": ["A+", "A", "B+", "B", "C+", "C", "D+", "D"] },
        "date":        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "dateDisplay": { "type": "string", "description": "Human-readable date, e.g. '21 juin 2026'" },
        "description": { "type": "string", "maxLength": 300 },
        "ogDescription": { "type": "string", "maxLength": 200 },
        "version":     { "type": "integer", "default": 1, "description": "Incremented on re-render, enables archive history" },
        "lastMcpRefresh": { "type": "string", "description": "ISO timestamp of last MCP data fetch" },
        "status":      { "type": "string", "enum": ["active", "invalidated", "archived"], "default": "active" },
        "invalidationNote": { "type": "string", "description": "If status=invalidated, explain why (e.g. 'Price ran past entry, R/R collapsed')" }
      }
    },

    "header": {
      "type": "object",
      "required": ["ticker", "name", "exchange", "sector", "price", "changePct"],
      "additionalProperties": false,
      "properties": {
        "ticker":       { "type": "string" },
        "name":         { "type": "string" },
        "exchange":     { "type": "string" },
        "sector":       { "type": "string" },
        "price":        { "type": "number" },
        "changePct":    { "type": "number", "description": "Daily change as decimal, e.g. 1.05 for +1.05%" },
        "badges":       { "type": "array", "items": {
          "type": "object",
          "required": ["text", "color"],
          "properties": {
            "text":  { "type": "string" },
            "color": { "type": "string", "enum": ["green", "red", "blue", "purple", "amber", "gray"] }
          }
        }},
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "marketCap":     { "type": "string", "description": "Formatted, e.g. '$5.88B'" },
            "volume":        { "type": "string", "description": "Formatted, e.g. '268.1K'" },
            "fwdPE":         { "type": "string", "description": "e.g. '12.8x'" },
            "beta":          { "type": "number" },
            "range52w":      { "type": "string", "description": "e.g. '$87 – $198'" },
            "shortInterest": { "type": "string", "description": "e.g. '5.1%'" },
            "divYield":      { "type": "string", "description": "e.g. '0.74%'" },
            "analystTarget": { "type": "string" },
            "pegRatio":      { "type": "string" },
            "evEbitda":      { "type": "string" }
          }
        },
        "halal":        { "type": "boolean", "default": false },
        "halalStatus":  { "type": "string", "enum": ["halal", "disputed", "non-halal"] }
      }
    },

    "verdict": {
      "type": "object",
      "required": ["score", "conviction", "bias"],
      "additionalProperties": false,
      "properties": {
        "score":       { "type": "integer", "minimum": 0, "maximum": 100 },
        "conviction":  { "type": "string", "enum": ["Very High", "High", "Moderate", "Low"] },
        "bias":        { "type": "string", "enum": ["Bullish", "Bearish", "Neutral"] },
        "confidence":  { "type": "string", "description": "e.g. 'High% confidence'" },
        "summary":     { "type": "string", "description": "2-3 sentence business + setup summary" },
        "whyBuy":      { "type": "array", "items": { "type": "string" }, "minItems": 3 },
        "whyAvoid":    { "type": "array", "items": { "type": "string" }, "minItems": 2 }
      }
    },

    "business": {
      "type": "object",
      "required": ["overview"],
      "additionalProperties": false,
      "properties": {
        "overview":    { "type": "string", "description": "HTML-safe business overview paragraph(s)" },
        "segments":    { "type": "array", "items": {
          "type": "object",
          "properties": {
            "name":    { "type": "string" },
            "revenue": { "type": "string" },
            "pct":     { "type": "string" },
            "description": { "type": "string" }
          }
        }},
        "moat":        { "type": "string" },
        "theme":       { "type": "string" }
      }
    },

    "news": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "title", "impact"],
        "additionalProperties": false,
        "properties": {
          "date":    { "type": "string" },
          "title":   { "type": "string" },
          "source":  { "type": "string" },
          "sourceUrl": { "type": "string", "format": "uri" },
          "impact":  { "type": "string", "enum": ["positive", "negative", "neutral"] },
          "detail":  { "type": "string" }
        }
      }
    },

    "fundamentals": {
      "type": "object",
      "required": ["rows"],
      "additionalProperties": false,
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["metric", "value"],
            "additionalProperties": false,
            "properties": {
              "metric":   { "type": "string" },
              "value":    { "type": "string" },
              "signal":   { "type": "string", "description": "Badge text, e.g. '+12% YoY'" },
              "signalColor": { "type": "string", "enum": ["green", "red", "blue", "amber", "gray"] },
              "comparison": { "type": "string", "description": "vs sector/peer context" }
            }
          }
        },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      }
    },

    "earnings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quarters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["quarter", "epsActual", "epsEstimate"],
            "properties": {
              "quarter":     { "type": "string", "description": "e.g. 'Q1 2026'" },
              "epsActual":   { "type": "number" },
              "epsEstimate": { "type": "number" },
              "surprise":    { "type": "string" },
              "revActual":   { "type": "string" },
              "revEstimate": { "type": "string" }
            }
          }
        },
        "beatStreak":  { "type": "integer" },
        "beatNote":    { "type": "string", "description": "e.g. '4 consecutive beats' or '3 beats + 1 inline'" },
        "nextEarnings": { "type": "string" }
      }
    },

    "insiders": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "insiderPct":    { "type": "string" },
        "institutionPct": { "type": "string" },
        "topHolders": { "type": "array", "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "pct":  { "type": "string" },
            "role": { "type": "string" }
          }
        }},
        "recentTransactions": { "type": "array", "items": {
          "type": "object",
          "properties": {
            "date":   { "type": "string" },
            "insider": { "type": "string" },
            "type":   { "type": "string", "enum": ["buy", "sell", "grant"] },
            "shares": { "type": "string" },
            "value":  { "type": "string" }
          }
        }},
        "signal":      { "type": "string" },
        "sourceRefs":  { "$ref": "#/$defs/sourceRefs" }
      }
    },

    "capitalStructure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sharesOutstanding": { "type": "string" },
        "sharesAuthorized":  { "type": "string" },
        "dilutionRisk":      { "type": "string", "enum": ["low", "moderate", "high", "critical"] },
        "warrants": { "type": "array", "items": {
          "type": "object",
          "properties": {
            "series":     { "type": "string" },
            "type":       { "type": "string" },
            "strike":     { "type": "number" },
            "shares":     { "type": "string" },
            "issued":     { "type": "string" },
            "expiration": { "type": "string" },
            "dilutionPct": { "type": "string" },
            "status":     { "type": "string", "enum": ["ITM", "ATM", "OTM", "Expired"] },
            "cashless":   { "type": "boolean" }
          }
        }},
        "atm": {
          "type": "object",
          "properties": {
            "active":     { "type": "boolean" },
            "authorized": { "type": "string" },
            "used":       { "type": "string" },
            "remaining":  { "type": "string" }
          }
        },
        "convertibles": { "type": "array", "items": {
          "type": "object",
          "properties": {
            "amount":     { "type": "string" },
            "conversionPrice": { "type": "string" },
            "maturity":   { "type": "string" }
          }
        }},
        "shareHistory": { "type": "string", "description": "e.g. 'Shares 1Y ago: 30M, now: 33M (+10%)'" },
        "sourceRefs":   { "$ref": "#/$defs/sourceRefs" }
      }
    },

    "shortInterest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "siPct":        { "type": "string" },
        "daysToCover":  { "type": "string" },
        "ctb":          { "type": "string" },
        "trend":        { "type": "string", "description": "e.g. 'Increasing over 3 months'" },
        "squeezeScore": { "type": "string" },
        "sourceRefs":   { "$ref": "#/$defs/sourceRefs" }
      }
    },

    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "callOI":   { "type": "string" },
        "putOI":    { "type": "string" },
        "cpRatio":  { "type": "string" },
        "maxPain":  { "type": "string" },
        "ivMean":   { "type": "string" },
        "skew":     { "type": "string" },
        "unusual":  { "type": "string" },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      }
    },

    "technicals": {
      "type": "object",
      "required": ["rsi14", "ema20", "ema50", "ema200"],
      "additionalProperties": false,
      "properties": {
        "rsi14":     { "type": "number" },
        "macd":      { "type": "number" },
        "macdSignal": { "type": "number" },
        "ema20":     { "type": "number" },
        "ema50":     { "type": "number" },
        "ema200":    { "type": "number" },
        "atr14":     { "type": "number" },
        "obv":       { "type": "string" },
        "wyckoff":   { "type": "string" },
        "supports":  { "type": "array", "items": { "type": "number" }, "maxItems": 3 },
        "resistances": { "type": "array", "items": { "type": "number" }, "maxItems": 3 },
        "extensionPct": { "type": "number", "description": "(price/ema20 - 1) * 100" },
        "emaStackValid": { "type": "boolean", "description": "EMA20 > EMA50 > EMA200, all rising" },
        "setupNote":   { "type": "string", "description": "Technical setup paragraph" },
        "badges":      { "type": "array", "items": { "type": "string" }, "description": "e.g. ['Above EMA200', 'MACD Bullish']" },
        "radarValues": {
          "type": "object",
          "description": "Normalized 0-100 values for technical radar chart",
          "properties": {
            "rsi":        { "type": "integer" },
            "trend":      { "type": "integer" },
            "volume":     { "type": "integer" },
            "momentum":   { "type": "integer" },
            "volatility": { "type": "integer" },
            "support":    { "type": "integer" }
          }
        },
        "sourceRefs":  { "$ref": "#/$defs/sourceRefs" }
      }
    },

    "sectorComparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sectorEtf":  { "type": "string", "description": "e.g. 'XLI'" },
        "peers": { "type": "array", "items": {
          "type": "object",
          "required": ["ticker"],
          "properties": {
            "ticker":     { "type": "string" },
            "name":       { "type": "string" },
            "price":      { "type": "string" },
            "pe":         { "type": "string" },
            "ytd":        { "type": "string" },
            "marketCap":  { "type": "string" },
            "correlation": { "type": "string" }
          }
        }},
        "positioning": { "type": "string", "enum": ["leader", "follower", "laggard"] },
        "sourceRefs":  { "$ref": "#/$defs/sourceRefs" }
      }
    },

    "macro": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "indicators": { "type": "array", "items": {
          "type": "object",
          "required": ["name", "value"],
          "properties": {
            "name":   { "type": "string" },
            "value":  { "type": "string" },
            "signal": { "type": "string" }
          }
        }},
        "regime":     { "type": "string", "enum": ["risk-on", "neutral", "risk-off"] },
        "impact":     { "type": "string" },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      }
    },

    "risks": {
      "type": "object",
      "required": ["riskScore", "riskCards"],
      "additionalProperties": false,
      "properties": {
        "riskScore": { "type": "integer", "minimum": 1, "maximum": 10 },
        "riskProfile": { "type": "string", "enum": ["Low", "Moderate", "High", "Very High"] },
        "riskSummary": { "type": "string" },
        "riskCards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "severity"],
            "additionalProperties": false,
            "properties": {
              "title":       { "type": "string" },
              "icon":        { "type": "string", "description": "FA icon, e.g. 'fa-ship'" },
              "severity":    { "type": "string", "enum": ["critical", "high", "medium", "low"] },
              "points":      { "type": "array", "items": { "type": "string" } },
              "probability": { "type": "integer", "minimum": 0, "maximum": 100 },
              "impact":      { "type": "integer", "minimum": 0, "maximum": 100 },
              "verdict":     { "type": "string" }
            }
          }
        },
        "riskRadarValues": {
          "type": "object",
          "description": "Normalized 0-100 for risk radar chart",
          "properties": {
            "dilution":       { "type": "integer" },
            "burnRate":       { "type": "integer" },
            "beta":           { "type": "integer" },
            "shortInterest":  { "type": "integer" },
            "insiderSelling": { "type": "integer" },
            "macroRisk":      { "type": "integer" }
          }
        },
        "pedagogy":   { "type": "string", "description": "Synthesis paragraph" },
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      }
    },

    "social": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platforms": { "type": "array", "items": {
          "type": "object",
          "required": ["platform", "icon"],
          "properties": {
            "platform": { "type": "string" },
            "icon":     { "type": "string", "description": "FA icon class, e.g. 'fa-brands fa-reddit'" },
            "mentions": { "type": "string" },
            "trend":    { "type": "string" },
            "trendColor": { "type": "string", "enum": ["green", "red", "blue", "amber", "gray"] },
            "detail":   { "type": "string" }
          }
        }},
        "pumpDumpScore": { "type": "integer", "minimum": 0, "maximum": 6 },
        "pumpDumpChecklist": { "type": "array", "items": {
          "type": "object",
          "properties": {
            "criterion": { "type": "string" },
            "pass":      { "type": "boolean" }
          }
        }},
        "sourceRefs": { "$ref": "#/$defs/sourceRefs" }
      }
    },

    "bottomEstimation": {
      "type": "object",
      "additionalProperties": false,
      "description": "Expert-only section",
      "properties": {
        "probability":    { "type": "integer", "minimum": 0, "maximum": 100 },
        "scenarios": { "type": "array", "items": {
          "type": "object",
          "required": ["label", "price", "basis"],
          "properties": {
            "label": { "type": "string", "enum": ["optimistic", "base", "pessimistic"] },
            "price": { "type": "number" },
            "basis": { "type": "string" }
          }
        }},
        "confluences": { "type": "array", "items": { "type": "string" } },
        "setups": { "type": "array", "items": {
          "type": "object",
          "properties": {
            "pattern":      { "type": "string" },
            "timeframe":    { "type": "string" },
            "trigger":      { "type": "string" },
            "target":       { "type": "string" },
            "invalidation": { "type": "string" },
            "progress":     { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        }}
      }
    },

    "manipulations": {
      "type": "object",
      "additionalProperties": false,
      "description": "Expert-only: market integrity analysis",
      "properties": {
        "anomalies": { "type": "array", "items": {
          "type": "object",
          "properties": {
            "type":       { "type": "string" },
            "severity":   { "type": "string", "enum": ["low", "medium", "high"] },
            "data":       { "type": "string" },
            "interpretation": { "type": "string" },
            "history":    { "type": "string" }
          }
        }},
        "secFilings": { "type": "array", "items": {
          "type": "object",
          "properties": {
            "date":    { "type": "string" },
            "type":    { "type": "string" },
            "issuer":  { "type": "string" },
            "detail":  { "type": "string" },
            "signal":  { "type": "string" }
          }
        }},
        "hostileFundsVerdict": { "type": "string" },
        "integrityVerdict":    { "type": "string" }
      }
    },

    "tradeIdea": {
      "type": "object",
      "required": ["entry", "stop", "tp1", "rr"],
      "additionalProperties": false,
      "properties": {
        "entry":       { "type": "number" },
        "entryNote":   { "type": "string", "description": "e.g. 'Momentum entry'" },
        "stop":        { "type": "number" },
        "stopPct":     { "type": "string", "description": "e.g. '-6.2% risk'" },
        "tp1":         { "type": "number" },
        "tp1Pct":      { "type": "string", "description": "e.g. '+11.4% upside'" },
        "tp2":         { "type": "number" },
        "tp2Pct":      { "type": "string" },
        "rr":          { "type": "string", "description": "e.g. '1:1.8'" },
        "horizon":     { "type": "string", "description": "e.g. '15-day horizon'" },
        "thesis":      { "type": "string" },
        "catalysts":   { "type": "array", "items": { "type": "string" } },
        "invalidation": { "type": "array", "items": { "type": "string" } },
        "status":      { "type": "string", "enum": ["active", "triggered", "invalidated", "tp1-hit", "tp2-hit", "stopped"], "default": "active" },
        "statusNote":  { "type": "string" },
        "forecast":    {
          "type": "object",
          "properties": {
            "ciLow":     { "type": "number" },
            "ciHigh":    { "type": "number" },
            "horizon":   { "type": "string" },
            "mape":      { "type": "string" }
          }
        }
      }
    },

    "globalScore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile":    { "type": "string", "enum": ["Speculative", "Growth", "Value", "Momentum", "Contrarian", "Income"] },
        "keyTakeawaysPositive": { "type": "array", "items": { "type": "string" }, "maxItems": 3 },
        "keyTakeawaysNegative": { "type": "array", "items": { "type": "string" }, "maxItems": 3 },
        "mindsetTip": { "type": "string" }
      }
    },

    "archiveHistory": {
      "type": "array",
      "description": "Previous versions for the history modal",
      "items": {
        "type": "object",
        "required": ["date", "dateDisplay"],
        "properties": {
          "date":        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "dateDisplay": { "type": "string" },
          "grade":       { "type": "string" },
          "note":        { "type": "string" }
        }
      }
    },

    "disclaimer": {
      "type": "string",
      "description": "Custom disclaimer text. Defaults used if omitted."
    }
  },

  "$defs": {
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string" },
          "url":  { "type": "string", "format": "uri" },
          "date": { "type": "string" }
        }
      }
    }
  }
}
