#!/bin/bash

# ─── Garde-fou anti-dérive du hook lui-même ───
# `.git/hooks/` n'est pas versionné : rien ne copiait ce fichier dedans, et aucun installeur
# n'existait. Constaté le 2026-09-14 : la copie active datait du 3 juillet et avait deux mois de
# retard — `test-series-ux`, `gen-tech-catalog` et le gate des chiffres n'avaient donc JAMAIS tourné
# localement, alors que le fichier versionné les contenait. Un garde-fou qu'on croit actif est pire
# qu'un garde-fou absent. Ce bloc compare la copie active à la source et le dit.
HOOK_SRC="tools/git-hooks/pre-commit"
HOOK_ACTIVE="$(git rev-parse --git-path hooks/pre-commit 2>/dev/null)"
if [ -f "$HOOK_SRC" ] && [ -f "$HOOK_ACTIVE" ] && ! cmp -s "$HOOK_SRC" "$HOOK_ACTIVE"; then
  echo "⚠️  [Pre-commit] le hook actif a dérivé de sa source versionnée."
  echo "   → bash tools/install-hooks.sh   (sinon les gates ajoutés depuis ne tournent pas)"
fi
# Pre-commit hook: secret guard + generate search index and sitemap
#
# Version-controlled reference copy. Install with:
#   cp tools/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# (.git/hooks/ is NOT versioned, so re-run after a fresh clone.)

# ── Secret guard (SEC-001) — block staging of .env or obvious secrets ──
STAGED=$(git diff --cached --name-only)
if echo "$STAGED" | grep -qE '(^|/)\.env($|\.)'; then
  echo "🛑 [pre-commit] Refus : un fichier .env est en staging (secrets interdits). git restore --staged <file>."
  exit 1
fi
if git diff --cached -U0 -- . ':(exclude)assets/search-index.json' ':(exclude)data/search_data.js' \
   | grep -nE 'sk-ant-(api|oauth)[0-9A-Za-z_-]{8,}|AIza[0-9A-Za-z_-]{30,}|[0-9]{8,10}:AA[0-9A-Za-z_-]{30,}|xox[baprs]-[0-9A-Za-z-]{10,}|Bearer [0-9a-fA-F]{32,}|mcp_[A-Za-z0-9][A-Za-z0-9_-]{19,}' >/dev/null; then
  echo "🛑 [pre-commit] Refus : motif de secret détecté dans le diff (clé Anthropic/Google, token Telegram/Slack, bearer/mcp token). Retire-le avant de committer."
  exit 1
fi

# ─── Series/Tech UX : catalogue structuré + contrat statique ───────────────
if echo "$STAGED" | grep -qE '^(series/|tech/|data/(tech|tech-series-catalog|series-catalog)\.json$|assets/(core|report|style)\.(js|css)$|index\.html$|tools/(gen-tech-catalog\.cjs|test-series-ux\.js)$)'; then
  echo "🧭 [Pre-commit] Regenerating Tech catalog and checking Series/Tech UX..."
  node tools/gen-tech-catalog.cjs
  git add data/tech-catalog.json
  node tools/test-series-ux.js || exit 1
fi

# ─── Content QA Gate : tout article édité doit passer qa-content --strict ───
# (classes de bugs du nightly refresh : prix $0.00, placeholders, R/R templatés,
# régime title≠signals.json — voir .claude/memory/feedback_refresh_body_stale.md)
STAGED_ARTICLES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^((analyses|daily|weekly|scanner)/[^/]+|scanner/retrospective/[^/]+)/index\.html$' | grep -vE '/(archive|status)/' | grep -vE '^scanner/(status/|retrospective/index\.html$)' || true)
if [ -n "$STAGED_ARTICLES" ]; then
  echo "🔎 [Pre-commit] QA content gate sur $(echo "$STAGED_ARTICLES" | wc -l | tr -d ' ') article(s)..."
  if ! echo "$STAGED_ARTICLES" | xargs node tools/qa-content.js --strict > /tmp/qa-content-precommit.log 2>&1; then
    grep -E "❌" /tmp/qa-content-precommit.log | head -20
    echo "⛔ [Pre-commit] qa-content --strict a échoué — commit bloqué. Détails: /tmp/qa-content-precommit.log"
    echo "   (bypass exceptionnel: git commit --no-verify, à justifier)"
    exit 1
  fi
fi

# ─── Preuve des chiffres : tout article qui porte un manifeste de claims le fait vérifier ───
# Ce gate existe depuis longtemps mais n'était invoqué QUE par les contrats de commande, donc
# seulement si l'auteur y pensait. Le 2026-09-13 un hebdo est parti avec un titre bâti sur une
# lecture fausse et 42 « claims vérifiées » pendant que tous ses horaires de calendrier, écrits en
# toutes lettres, n'étaient reliés à rien. Un gate qui dépend de la mémoire de l'auteur n'est pas
# un gate. Il ne tourne que pour les articles qui ont un socle : les pages sans `_data/claims.json`
# ne sont pas concernées.
if [ -n "$STAGED_ARTICLES" ]; then
  CLAIMS_FAIL=0
  for ART in $STAGED_ARTICLES; do
    MANIFEST="$(dirname "$ART")/_data/claims.json"
    [ -f "$MANIFEST" ] || continue
    if ! node tools/validate-content-claims.js "$MANIFEST" > /tmp/claims-precommit.log 2>&1; then
      echo "⛔ [Pre-commit] chiffres non prouvés dans $ART :"
      tail -n +2 /tmp/claims-precommit.log | head -8
      CLAIMS_FAIL=1
    fi
  done
  if [ "$CLAIMS_FAIL" = "1" ]; then
    echo "   Chaque nombre publié doit être lié à sa source (data-claim) ou déclaré (data-literal)."
    echo "   (bypass exceptionnel: git commit --no-verify, à justifier)"
    exit 1
  fi
fi

# ─── Voix éditoriale : advisory anti-tics IA (NON bloquant) — voir EDITORIAL_STYLE.md ───
# Attrape la couche 1 (tics de style). La couche 2 (empreinte intellectuelle) reste un jugement.
if [ -n "$STAGED_ARTICLES" ]; then
  TELLS=$(echo "$STAGED_ARTICLES" | xargs node tools/check-ai-tells.js 2>/dev/null | grep -E "❌|⚠️" || true)
  if [ -n "$TELLS" ]; then
    echo "✍️  [Pre-commit] Voix éditoriale — tics IA détectés (non bloquant, cf EDITORIAL_STYLE.md) :"
    echo "$TELLS" | head -12
    echo "   → réécrire si possible ; vérifier aussi la couche 2 (catalyseur/flux/asymétrie/thèse)."
  fi
fi

echo "📈 [Pre-commit] Updating search index and sitemap..."

# Run the python scripts to rebuild the index and sitemap
python3 tools/build_search_index.py
python3 tools/build_sitemap_rss.py
node tools/build_rss.js

# Update search_data.js cache buster in index.html
TODAY=$(date '+%Y%m%d%H%M')
sed -i '' "s|search_data\.js?v=[0-9]*|search_data.js?v=${TODAY}|g" index.html

# Add the updated files to the staging area so they are committed
git add assets/search-index.json
git add sitemap.xml
git add feed.xml
git add index.html

echo "✅ [Pre-commit] Finished successfully. Committing..."
