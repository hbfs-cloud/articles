    "forbidden_server_patterns": ["broker", "broker_live", "trading"],
    "forbidden_tool_aliases": [
      "GetHealth",
      "GetMarketOverview",
      "GetRegimeProbability",
      "GetCorrelationMatrix",
      "OptimizeSizing",
      "CheckJobStatus"
    ],
    "web_allowed": [
      "SEC EDGAR primary filings",
      "company investor-relations releases and transcripts",
      "official macro and central-bank calendars",
      "current news attribution with a named source"
    ],
    "web_forbidden_as_fallback": [
      "prices and returns",
      "bars and technical indicators",
      "fundamentals and valuation inputs",
      "options, short-interest and flow metrics",
      "screening, scoring, sizing and backtests"
    ],
    "publication_gates": [
      "reference-close freshness",
      "deterministic numeric validation",
      "contrarian and retail war-room review",
      "senior review",
      "local strict QA"
    ],
    "command_contract": {
      "required_references": [".claude/skills/source-policy.md"],
      "forbidden_patterns": [
        {
          "pattern": "mcp__claude",
          "message": "Claude-only MCP aliases are forbidden in active runbooks"
        },
        {
          "pattern": "min_expected_move(?!_pct)",
          "message": "use the audited min_expected_move_pct argument"
        },
        {
          "pattern": "GetSymbolSignals\\([^\\n)]*symbols\\s*=",
          "message": "GetSymbolSignals is mono-symbol"
        },
        {
          "pattern": "MCP_TOKEN_[A-Z_]+\\s*=\\s*['\\\"]?[A-Za-z0-9._-]{16,}",
          "message": "token-looking values are forbidden in runbooks"
        }
      ]
    }
  },
  "workflows": {
    "daily": {
      "command": ".claude/commands/daily.md",
      "codex_skills": ["daily"],
      "plans": [
        {
          "path": "plans/daily.json",
          "required_variables": ["date", "refdate", "crypto_refdate"],
          "static_symbol_calls": ["bars_indices", "bars_sectors", "bars_crypto"]
        },
        {
          "path": "plans/daily-focus.json",
          "required_variables": ["date", "refdate", "focus_symbols"],
          "variable_constraints": {
            "focus_symbols": { "type": "csv", "min_items": 1, "max_items": 6 }
          }
        }
      ]
    },
    "weekly": {
      "command": ".claude/commands/weekly.md",
      "codex_skills": ["weekly"],
      "plans": [
        {
          "path": "plans/weekly.json",
          "required_variables": ["date", "refdate"],
          "static_symbol_calls": [
            "bars_indices",
            "bars_sectors",
            "bars_crypto",
            "correlations",
            "short_interest"
          ]
        },
        {
          "path": "plans/weekly-focus.json",
          "required_variables": [
            "date",
            "refdate",
            "focus_symbols",
            "blast_symbols"
          ],
          "variable_constraints": {
            "focus_symbols": { "type": "csv", "min_items": 1, "max_items": 8 },
            "blast_symbols": {
              "type": "csv",
              "min_items": 4,
              "max_items": 16,
              "item_pattern": "^[A-Z][A-Z0-9.=-]{0,14}$"
            }
          }
        }
      ]
    },
    "analyse": {
      "aliases": ["analysis"],
      "command": ".claude/commands/analyse.md",
      "codex_skills": ["analyse", "analysis"],
      "plans": [
        {
          "path": "plans/analyse.json",
          "required_variables": [
            "symbol",
            "refdate",
            "comparison_start_date",
            "comparison_symbols",
            "documented_client_symbols"
          ],
          "variable_constraints": {
            "symbol": {
              "type": "csv",
              "min_items": 1,
              "max_items": 1,
              "item_pattern": "^[A-Z][A-Z0-9.-]{0,14}$"
            },
            "comparison_start_date": {
              "type": "csv",
              "min_items": 1,
              "max_items": 1,
              "item_pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
            },
            "comparison_symbols": {
              "type": "csv",
              "min_items": 12,
              "max_items": 30,
              "item_pattern": "^[A-Z][A-Z0-9.=-]{0,14}$"
            },
            "documented_client_symbols": {
              "type": "csv",
              "min_items": 1,
              "max_items": 10,
              "item_pattern": "^[A-Z][A-Z0-9.=-]{0,14}$"
            }
          }
        }
      ]
    },
    "aplus": {
      "command": ".claude/commands/aplus.md",
      "codex_skills": ["aplus"],
      "plans": [
        {
          "path": "plans/aplus-screen.json",
          "required_variables": ["date", "refdate"]
        },
        {
          "path": "plans/aplus-verify.json",
          "required_variables": ["date", "refdate", "symbols"],
          "variable_constraints": {
            "symbols": {
              "type": "csv",
              "min_items": 1,
              "max_items": 10,
              "item_pattern": "^[A-Z][A-Z0-9.-]{0,9}$"
            }
          }
        },
        {
          "path": "plans/aplus-correlation.json",
          "required_variables": ["date", "refdate", "symbols"],
          "variable_constraints": {
            "symbols": {
              "type": "csv",
              "min_items": 2,
              "max_items": 10,
              "item_pattern": "^[A-Z][A-Z0-9.-]{0,9}$"
            }
          }
        }
      ]
    },
