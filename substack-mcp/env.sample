# substack-mcp — example env. NEVER commit real values.
# In production these come from the secret store (Infisical), NOT from a committed .env.

# Substack publication subdomain (dailytickers.substack.com -> "dailytickers")
SUBSTACK_PUBLICATION=dailytickers

# Session cookie captured after an INTERACTIVE login to substack.com (see SUBSTACK_MCP_PLAN.md §3).
# Format: the raw Cookie header value, e.g. "substack.sid=...; connect.sid=..."
SUBSTACK_COOKIE=

# Bearer token that claude.ai must present to reach this MCP (OAuth2 layer terminates upstream).
MCP_AUTH_TOKEN=

# HTTP port the MCP listens on (reverse-proxy target).
PORT=8080

# Path to the articles repo's converter (tools/gen-substack-draft.js).
# Local dev default assumes substack-mcp/ lives inside the articles repo.
GEN_SUBSTACK_DRAFT=../tools/gen-substack-draft.js
