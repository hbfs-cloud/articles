# TLS termination + reverse-proxy for the Substack MCP.
# DNS: substack.dailytickers.com -> Oracle VM public IP. Caddy auto-provisions the certificate.
substack.dailytickers.com {
	encode zstd gzip

	# Health check passthrough.
	handle /healthz {
		reverse_proxy substack-mcp:8080
	}

	# MCP endpoint. OAuth2 is handled by the claude.ai registration flow; the bearer token check
	# happens in the app. Add caddy-level auth here too if desired.
	handle /mcp* {
		reverse_proxy substack-mcp:8080
	}

	respond "substack-mcp" 200
}
