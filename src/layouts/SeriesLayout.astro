---
/**
 * SeriesLayout — Multi-part series articles.
 * Integrates: SeriesBar (top+bottom), ArticleNav, VariantSwitcher.
 * Used for: timing-the-market, guide-speculateur, bon-pere-de-famille, etc.
 */
import BaseLayout from './BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import ArticleNav from '../components/ArticleNav.astro';
import SeriesBar from '../components/SeriesBar.astro';
import VariantSwitcher from '../components/VariantSwitcher.astro';

interface SectionItem {
  id: string;
  icon?: string;
  label: string;
}

interface SeriesStep {
  label: string;
  href: string;
  current?: boolean;
}

interface HeroBadge {
  text: string;
  color: 'red' | 'green' | 'blue' | 'purple' | 'amber' | 'silver';
  icon?: string;
}

interface LevelOption {
  level: 'expert' | 'beginner' | 'intermediate';
  label?: string;
  active?: boolean;
}

interface LangOption {
  lang: string;
  flag: string;
  active?: boolean;
}

interface Props {
  title: string;
  subtitle?: string;
  dateLine?: string;
  dateColor?: string;
  heroGradient?: string;
  date?: string;
  tags: string[];
  badges?: HeroBadge[];
  sections?: SectionItem[];
  series?: {
    title: string;
    steps: SeriesStep[];
  };
  levels?: LevelOption[];
  langs?: LangOption[];
  variantsJsonPath?: string;
  description?: string;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  level?: 'expert' | 'beginner' | 'intermediate';
}

const {
  title,
  subtitle,
  dateLine,
  dateColor = '#0d9488',
  heroGradient = 'linear-gradient(180deg, #f0fdfa 0%, #f8fafc 100%)',
  date,
  tags,
  badges = [],
  sections = [],
  series,
  levels = [],
  langs = [],
  variantsJsonPath,
  description,
  lang = 'en',
  dir = 'ltr',
  level = 'expert',
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description || subtitle}
  date={date}
  tags={tags}
  tab="series"
  lang={lang}
  dir={dir}
  theme="light"
  level={level}
>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
  </Fragment>

  <Fragment slot="brand-actions">
    {(levels.length > 0 || langs.length > 0) && (
      <div class="switcher-bar">
        {langs.map(l => (
          <a class={`switcher-btn ${l.active ? 'active' : ''}`} title={l.lang.toUpperCase()}>
            {l.flag} {l.lang.toUpperCase()}
          </a>
        ))}
        {levels.map(l => (
          <a class={`switcher-btn ${l.active ? 'active' : ''}`}>
            {l.label || (l.level === 'beginner' ? 'Beginner' : l.level === 'intermediate' ? 'Intermediate' : 'Expert')}
          </a>
        ))}
      </div>
    )}
  </Fragment>

  <!-- Hero -->
  <HeroSection
    title={title}
    subtitle={subtitle}
    dateLine={dateLine}
    dateColor={dateColor}
    badges={badges}
    gradient={heroGradient}
  />

  <!-- Series wizard (TOP) -->
  {series && <SeriesBar title={series.title} steps={series.steps} position="top" />}

  <!-- Main content -->
  <div class="container">
    <slot />
  </div>

  <!-- Series wizard (BOTTOM) — identical to top -->
  {series && <SeriesBar title={series.title} steps={series.steps} position="bottom" />}

  <!-- Floating section nav -->
  {sections.length > 0 && <ArticleNav sections={sections} />}

  <Fragment slot="scripts">
    <slot name="charts" />
    {variantsJsonPath && (
      <script is:inline define:vars={{ variantsJsonPath }}>
        (function(){
          fetch(variantsJsonPath).then(function(r){
            return r.json();
          }).then(function(data){
            document.querySelectorAll('.switcher-btn').forEach(function(btn){
              btn.addEventListener('click', function(e){
                e.preventDefault();
                // Find matching variant from text
                var text = this.textContent.trim().toLowerCase();
                var variant = data.variants.find(function(v){
                  return v.lang === text || v.level === text;
                });
                if(variant) window.location.href = variant.path;
              });
            });
          }).catch(function(){});
        })();
      </script>
    )}
  </Fragment>
</BaseLayout>
