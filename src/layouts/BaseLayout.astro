---
/**
 * BaseLayout — Shared by ALL article types.
 * Guarantees: GTM, fonts, CSS, brand bar, footer, tags.
 * No LLM can break this.
 */

interface Props {
  title: string;
  description?: string;
  date?: string;
  tags?: string[];
  tab?: 'weekly' | 'daily' | 'analyses' | 'scanner' | 'series' | 'tech';
  lang?: string;
  dir?: 'ltr' | 'rtl';
  theme?: 'light' | 'dark';
  level?: 'expert' | 'beginner' | 'intermediate';
  ogImage?: string;
  canonical?: string;
}

const {
  title,
  description = 'Intelligence Institutionnelle — DailyTickers',
  date,
  tags = [],
  tab = 'analyses',
  lang = 'fr',
  dir = 'ltr',
  theme = 'light',
  level = 'expert',
  ogImage = 'https://articles.dailytickers.com/favicon.ico',
  canonical,
} = Astro.props;

const cssFile = theme === 'dark' ? '/assets/report-dark.css' : '/assets/report.css';
const tagsString = tags.join(',');
const fullTitle = `${title} | DailyTickers`;
---

<!DOCTYPE html>
<html lang={lang} dir={dir} data-tags={tagsString} data-tab={tab} data-level={level}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:type" content="article" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="DailyTickers" />
  {canonical && <link rel="canonical" href={canonical} />}
  <link rel="icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#2563eb" />

  <!-- Google Tag Manager -->
  <script is:inline>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-T5Z595CW');
  </script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <!-- Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <!-- Theme CSS -->
  <link rel="stylesheet" href={cssFile} />

  <!-- Additional head content (charts, page-specific) -->
  <slot name="head" />
</head>
<body>
  <!-- GTM noscript -->
  <noscript>
    <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-T5Z595CW"
            height="0" width="0" style="display:none;visibility:hidden"></iframe>
  </noscript>

  <!-- Standardized Brand Bar — matches dailytickers.com -->
  <nav class="brand-bar">
    <div class="brand-bar-inner">
      <a href="/" class="brand-logo">
        <img src="/logo.svg" alt="" width="36" height="36" />
        <span class="brand-title">DailyTickers</span>
      </a>
      <div class="brand-actions">
        <slot name="brand-actions" />
        <a href="/" class="brand-home-btn" title="Accueil"><i class="fas fa-house"></i></a>
      </div>
    </div>
  </nav>

  <!-- Main content -->
  <slot />

  <!-- Standardized Footer -->
  <footer class="article-footer">
    <slot name="footer-extra" />
    &copy; {new Date().getFullYear()} DailyTickers. Données via DailyTickers Gateway.
    Ceci n'est pas un conseil financier.
    <br /><a href="/" title="Accueil"><i class="fas fa-house" style="margin-right:4px;"></i></a>
  </footer>

  <!-- Tag renderer -->
  <script is:inline src="/assets/core.js"></script>

  <!-- Additional scripts (ECharts init, etc.) -->
  <slot name="scripts" />
</body>
</html>
