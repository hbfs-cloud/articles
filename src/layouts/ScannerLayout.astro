---
/**
 * ScannerLayout — Scanner (daily scans + retrospectives).
 * Uses light theme (report.css). Integrates ArticleNav + ChartModal.
 */
import BaseLayout from './BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import ArticleNav from '../components/ArticleNav.astro';
import HistoryModal from '../components/HistoryModal.astro';
import ChartModal from '../components/ChartModal.astro';

interface SectionItem {
  id: string;
  icon?: string;
  label: string;
}

interface HeroBadge {
  text: string;
  color: 'red' | 'green' | 'blue' | 'purple' | 'amber' | 'silver';
  icon?: string;
}

interface HistoryEntry {
  date: string;
  title: string;
  href?: string;
  current?: boolean;
}

interface Props {
  title: string;
  subtitle?: string;
  dateLine?: string;
  dateColor?: string;
  heroGradient?: string;
  date: string;
  tags: string[];
  badges?: HeroBadge[];
  sections?: SectionItem[];
  history?: HistoryEntry[];
  description?: string;
  lang?: string;
  isRetrospective?: boolean;
}

const {
  title,
  subtitle,
  dateLine,
  dateColor = '#f59e0b',
  heroGradient = 'linear-gradient(180deg, #fffbeb 0%, #f8fafc 100%)',
  date,
  tags,
  badges = [],
  sections = [],
  history = [],
  description,
  lang = 'fr',
  isRetrospective = false,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description || subtitle}
  date={date}
  tags={tags}
  tab="scanner"
  lang={lang}
  theme="light"
>
  <Fragment slot="head">
    <script is:inline src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
  </Fragment>

  <!-- Hero with optional history -->
  <HeroSection
    title={title}
    subtitle={subtitle}
    dateLine={dateLine}
    dateColor={dateColor}
    badges={badges}
    gradient={heroGradient}
  >
    {history.length > 0 && (
      <div style="margin-top:1rem; display:flex; justify-content:center;">
        <HistoryModal
          modalTitle={isRetrospective ? 'Rétrospectives' : 'Scans Quotidiens'}
          entries={history}
        />
      </div>
    )}
  </HeroSection>

  <!-- Floating section nav -->
  {sections.length > 0 && <ArticleNav sections={sections} />}

  <!-- Main content -->
  <div class="container">
    <slot />
  </div>

  <!-- Chart modal -->
  <ChartModal />

  <!-- Extra scripts -->
  <Fragment slot="scripts">
    <slot name="charts" />
  </Fragment>
</BaseLayout>
