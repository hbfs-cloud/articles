---
/**
 * SectionDivider — Horizontal divider with icon and label text.
 * Lines extend on both sides of the text.
 */

interface Props {
  id?: string;
  icon?: string;
  label: string;
}

const { id, icon, label } = Astro.props;
---

<div class="section-divider" id={id}>
  {icon && <i class={icon}></i>}
  {label}
</div>
