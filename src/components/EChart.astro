---
/**
 * EChart — Container for an ECharts instance.
 * Pass the chart ID and config as a JSON string.
 * The script tag initializes the chart on DOMContentLoaded.
 */
interface Props {
  id: string;
  height?: string;
  config: string;
}

const { id, height = '300px', config } = Astro.props;
---

<div id={id} style={`width:100%; height:${height};`}></div>
<script is:inline define:vars={{ id, config }}>
  document.addEventListener('DOMContentLoaded', function() {
    var el = document.getElementById(id);
    if (el && typeof echarts !== 'undefined') {
      var chart = echarts.init(el);
      chart.setOption(JSON.parse(config));
      window.addEventListener('resize', function() { chart.resize(); });
    }
  });
</script>
