---
/**
 * DashboardGrid — Quick metrics with colored top bars.
 * Matches the .dash-card design from existing daily articles.
 */

interface DashItem {
  label: string;
  value: string;
  change: string;
  direction: 'up' | 'down' | 'neutral';
  color?: 'green' | 'red' | 'blue' | 'amber' | 'purple';
}

interface Props {
  items: DashItem[];
  title?: string;
  titleIcon?: string;
  titleColor?: string;
}

const { items, title, titleIcon, titleColor } = Astro.props;

function autoColor(direction: string, explicit?: string): string {
  if (explicit) return explicit;
  if (direction === 'up') return 'green';
  if (direction === 'down') return 'red';
  return 'blue';
}
---

{title && (
  <h2>
    {titleIcon && <i class={titleIcon} style={`color:${titleColor || '#10b981'}; margin-right:8px;`}></i>}
    {title}
  </h2>
)}
<div class="dashboard-grid">
  {items.map(item => (
    <div class={`dash-card card-${autoColor(item.direction, item.color)}`}>
      <div class="dash-card-label">{item.label}</div>
      <div class="dash-card-value">{item.value}</div>
      <div class={`dash-card-change ${item.direction}`}>
        <i class={`fas fa-caret-${item.direction === 'up' ? 'up' : 'down'}`}></i>
        {item.change}
      </div>
    </div>
  ))}
</div>
