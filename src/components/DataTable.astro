---
/**
 * DataTable — Styled responsive table.
 * Handles up/down coloring on change columns automatically.
 */
interface Props {
  headers: string[];
  rows: string[][];
  caption?: string;
}

const { headers, rows, caption } = Astro.props;

function cellClass(cell: string): string {
  if (/^\+/.test(cell.trim()) || /hausse/i.test(cell)) return 'up';
  if (/^-/.test(cell.trim()) || /baisse/i.test(cell)) return 'down';
  return '';
}
---

<div class="table-responsive">
  <table class="data-table">
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr>
        {headers.map(h => <th>{h}</th>)}
      </tr>
    </thead>
    <tbody>
      {rows.map(row => (
        <tr>
          {row.map((cell, i) => (
            <td class={i > 0 ? cellClass(cell) : ''}>{cell}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
