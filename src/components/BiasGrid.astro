---
/**
 * BiasGrid — Grid of concept/bias cards.
 * Each card has an icon, title (h5), and description.
 */

interface BiasItem {
  icon: string;
  iconColor?: string;
  title: string;
  description: string;
}

interface Props {
  items: BiasItem[];
}

const { items } = Astro.props;
---

<div class="bias-grid">
  {items.map(item => (
    <div class="bias-card">
      <div class="bias-icon"><i class={item.icon} style={item.iconColor ? `color:${item.iconColor}` : ''}></i></div>
      <h5>{item.title}</h5>
      <p>{item.description}</p>
    </div>
  ))}
</div>
