---
/**
 * CodeBlock — Labeled code block wrapper.
 *
 * For use in MDX when you want a label above the code:
 *   <CodeBlock label="SQL — SCD Type 2 Pattern">
 *     ```sql
 *     SELECT * FROM instruments;
 *     ```
 *   </CodeBlock>
 *
 * Astro's built-in Shiki handles the syntax highlighting.
 * This component just adds the label + wrapper styling.
 */

interface Props {
  label?: string;
}

const { label } = Astro.props;
---

<div class="code-block-wrapper">
  {label && <div class="code-label">{label}</div>}
  <slot />
</div>
