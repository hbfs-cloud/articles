---
/**
 * HeroSection — Matches existing daily/weekly hero exactly.
 * - hero-date line above title
 * - hero-badges as pills
 * - clickable tags inside the hero
 * - configurable gradient
 */

interface HeroBadge {
  text: string;
  color: 'red' | 'green' | 'blue' | 'purple' | 'amber' | 'silver';
  icon?: string;
}

interface Props {
  title: string;
  subtitle?: string;
  dateLine?: string;
  dateColor?: string;
  badges?: HeroBadge[];
  gradient?: string;
}

const {
  title,
  subtitle,
  dateLine,
  dateColor = '#dc2626',
  badges = [],
  gradient = 'linear-gradient(180deg, #fff7ed 0%, #f8fafc 100%)',
} = Astro.props;
---

<section class="hero-section" style={`background: ${gradient};`}>
  <div class="container">
    {dateLine && (
      <div class="hero-date" style={`color: ${dateColor};`}>{dateLine}</div>
    )}
    <h1 class="hero-title" set:html={title} />
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    {badges.length > 0 && (
      <div class="hero-badges">
        {badges.map(b => (
          <span class={`hero-badge hero-badge-${b.color}`}>
            {b.icon && <i class={b.icon}></i>}
            {b.text}
          </span>
        ))}
      </div>
    )}
    <slot />
    <div id="article-clickable-tags" class="card-tags" style="margin-top:1.5rem; display:flex; justify-content:center;"></div>
  </div>
</section>
