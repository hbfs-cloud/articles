---
/**
 * NextCta — Call-to-action link to the next article/part.
 * Full-width gradient button with arrow icon.
 */

interface Props {
  href: string;
  label?: string;
  title: string;
  gradient?: string;
}

const {
  href,
  label = 'Next',
  title,
  gradient = 'linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%)',
} = Astro.props;
---

<a href={href} class="next-cta" style={`background:${gradient}`}>
  <i class="fa-solid fa-arrow-right"></i>
  <div>
    <div class="next-label">{label}</div>
    <div class="next-title">{title}</div>
  </div>
</a>
