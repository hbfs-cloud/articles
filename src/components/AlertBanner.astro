---
/**
 * AlertBanner — Subtle style: light bg + colored border + icon box + text.
 * Text is dark-colored for readability on light backgrounds.
 */
interface Props {
  title: string;
  text: string;
  type?: 'red' | 'green' | 'blue' | 'amber';
  icon?: string;
  id?: string;
}

const {
  title,
  text,
  type = 'red',
  icon = 'fa-solid fa-triangle-exclamation',
  id,
} = Astro.props;

const styles: Record<string, { bg: string; border: string; iconBg: string; titleColor: string; textColor: string }> = {
  red:   { bg: 'linear-gradient(135deg, #fef2f2, #fff7ed)', border: '#fecaca', iconBg: '#dc2626', titleColor: '#991b1b', textColor: '#b91c1c' },
  green: { bg: 'rgba(16, 185, 129, 0.1)',                   border: '#10b981', iconBg: '#10b981', titleColor: '#15803d', textColor: '#166534' },
  blue:  { bg: 'rgba(59, 130, 246, 0.1)',                   border: '#93c5fd', iconBg: '#3b82f6', titleColor: '#1e40af', textColor: '#1d4ed8' },
  amber: { bg: 'rgba(245, 158, 11, 0.1)',                   border: '#fcd34d', iconBg: '#f59e0b', titleColor: '#92400e', textColor: '#b45309' },
};

const s = styles[type] || styles.red;
---

<div class="alert-banner" id={id} style={`background: ${s.bg}; border: 1px solid ${s.border};`}>
  <div class="alert-banner-icon" style={`background: ${s.iconBg};`}>
    <i class={icon}></i>
  </div>
  <div class="alert-banner-content">
    <h4 style={`color: ${s.titleColor};`}>{title}</h4>
    <p style={`color: ${s.textColor};`}>{text}</p>
  </div>
</div>
