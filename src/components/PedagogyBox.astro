---
/**
 * PedagogyBox — Educational/info box.
 * Used for Formation du Jour, trade thesis, didactic content.
 */
interface Props {
  title?: string;
  type?: 'pedagogy' | 'didactic' | 'alert';
  icon?: string;
}

const { title, type = 'pedagogy', icon } = Astro.props;
const className = type === 'didactic' ? 'didactic-box' : type === 'alert' ? 'alert-box' : 'pedagogy-box';
---

<div class={className}>
  {title && (
    <h4>
      {icon && <i class={icon}></i>}
      {title}
    </h4>
  )}
  <slot />
</div>
