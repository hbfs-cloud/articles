---
/**
 * ScoreRow — Grid of metric/score display items.
 * Large number on top, label below.
 */

interface ScoreItem {
  value: string;
  label: string;
  color?: string;
}

interface Props {
  items: ScoreItem[];
}

const { items } = Astro.props;
---

<div class="score-row">
  {items.map(item => (
    <div class="score-item">
      <div class="big" style={item.color ? `color:${item.color}` : ''}>{item.value}</div>
      <div class="label">{item.label}</div>
    </div>
  ))}
</div>
