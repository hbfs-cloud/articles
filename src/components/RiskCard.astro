---
/**
 * RiskCard — Risk item with severity level.
 */
interface Props {
  title: string;
  description: string;
  severity: 'critical' | 'high' | 'medium' | 'low';
  probability?: string;
  impact?: string;
  icon?: string;
}

const { title, description, severity, probability, impact, icon = 'fa-solid fa-shield-halved' } = Astro.props;
---

<div class={`risk-card risk-card-${severity}`}>
  <div class="risk-card-header">
    <i class={icon}></i>
    <span class="risk-card-title">{title}</span>
    <span class={`risk-severity ${severity}`}>{severity.toUpperCase()}</span>
  </div>
  <div class="risk-card-body">
    <p>{description}</p>
    {(probability || impact) && (
      <div class="risk-metrics">
        {probability && <span>Probabilité: {probability}</span>}
        {impact && <span>Impact: {impact}</span>}
      </div>
    )}
  </div>
</div>
