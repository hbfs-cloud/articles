---
/**
 * VerdictGrid — Pros/Cons grid for analysis verdict.
 */
interface Props {
  pros: string[];
  cons: string[];
  prosTitle?: string;
  consTitle?: string;
}

const {
  pros,
  cons,
  prosTitle = 'Points Forts',
  consTitle = 'Risques Clés'
} = Astro.props;
---

<div class="verdict-grid">
  <div class="verdict-pro">
    <h4><i class="fa-solid fa-circle-check"></i> {prosTitle}</h4>
    <ul>
      {pros.map(p => <li>{p}</li>)}
    </ul>
  </div>
  <div class="verdict-con">
    <h4><i class="fa-solid fa-circle-xmark"></i> {consTitle}</h4>
    <ul>
      {cons.map(c => <li>{c}</li>)}
    </ul>
  </div>
</div>
