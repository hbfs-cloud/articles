---
/**
 * TradeBox — Trade idea: dark card + signals below.
 * The dark card contains entry/stop/TP grid.
 * Signals (bull/bear) are placed OUTSIDE the dark card for visibility.
 */

interface Props {
  ticker: string;
  name?: string;
  direction?: 'long' | 'short';
  entry: string;
  stop: string;
  tp1: string;
  tp2?: string;
  rr: string;
  thesis?: string;
  bias?: string;
  reinforcement?: string[];
  invalidation?: string[];
  timing?: string;
  id?: string;
}

const {
  ticker,
  name,
  direction = 'long',
  entry,
  stop,
  tp1,
  tp2,
  rr,
  thesis,
  bias = direction === 'long' ? 'BULLISH BIAS' : 'BEARISH BIAS',
  reinforcement = [],
  invalidation = [],
  timing,
  id,
} = Astro.props;

const levels = [
  { label: 'Entrée', value: entry, cls: 'entry' },
  { label: 'Stop', value: stop, cls: 'stop' },
  { label: 'TP1', value: tp1, cls: 'tp' },
  ...(tp2 ? [{ label: 'TP2', value: tp2, cls: 'tp' }] : []),
  { label: 'R/R', value: rr, cls: 'rr' },
];
---

<section class="content-card" id={id || 'trade'}>
  <!-- Dark card -->
  <div class="trade-box">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1.5rem;">
      <h3 class="trade-title">TRADE IDEA : {ticker} {name ? `— ${name}` : ''}</h3>
      <span style={`background:${direction === 'long' ? '#10b981' : '#ef4444'}; color:white; padding:4px 12px; border-radius:8px; font-size:0.8rem; font-weight:800;`}>{bias}</span>
    </div>

    {thesis && <p style="color:#94a3b8; font-size:0.9rem; line-height:1.6;">{thesis}</p>}

    <div class="trade-levels-grid" style={levels.length === 5 ? 'grid-template-columns: repeat(5, 1fr);' : ''}>
      {levels.map(l => (
        <div class="trade-level-card">
          <div class="trade-level-label">{l.label}</div>
          <div class={`trade-level-value ${l.cls}`}>{l.value}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- Signals OUTSIDE the dark card for visibility -->
  {reinforcement.length > 0 && (
    <div class="trade-signals trade-signals-bull">
      <h4><i class="fa-solid fa-circle-check"></i> Signaux de Renforcement</h4>
      <ul>
        {reinforcement.map(s => <li>{s}</li>)}
      </ul>
    </div>
  )}

  {invalidation.length > 0 && (
    <div class="trade-signals trade-signals-bear">
      <h4><i class="fa-solid fa-circle-xmark"></i> Signaux d'Annulation</h4>
      <ul>
        {invalidation.map(s => <li>{s}</li>)}
      </ul>
    </div>
  )}

  {timing && (
    <div class="alert-box" style="margin-top:1rem;">
      <h4><i class="fa-solid fa-clock"></i> Timing & Sizing</h4>
      <p>{timing}</p>
    </div>
  )}
</section>
