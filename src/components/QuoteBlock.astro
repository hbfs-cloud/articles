---
/**
 * QuoteBlock — Styled blockquote with attribution.
 * Dark gradient background, blue left border, decorative opening quote.
 */

interface Props {
  author?: string;
}

const { author } = Astro.props;
---

<div class="quote-block">
  <p><slot /></p>
  {author && <span class="quote-author">&mdash; {author}</span>}
</div>
