---
/**
 * ContentCard — Section wrapper with optional title.
 * Replaces: <div class="content-card"><h2>...</h2>...</div>
 */
interface Props {
  title?: string;
  id?: string;
}

const { title, id } = Astro.props;
---

<div class="content-card" id={id}>
  {title && <h2>{title}</h2>}
  <slot />
</div>
