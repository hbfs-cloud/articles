---
/**
 * NavGrid — Section navigation overlapping the hero (margin-top:-3rem).
 * Icons get individual colors like the existing articles.
 */

interface NavItem {
  href: string;
  icon: string;
  label: string;
  color?: string;
}

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;

const defaultColors = ['#dc2626', '#10b981', '#3b82f6', '#ec4899', '#9333ea', '#0f172a', '#f59e0b', '#6366f1'];
---

<div class="container">
  <div class="nav-grid" style="margin-top:-3rem;">
    {items.map((item, i) => (
      <a href={item.href} class="nav-item">
        <i class={item.icon} style={`color:${item.color || defaultColors[i % defaultColors.length]}; margin-bottom:0.4rem;`}></i>
        {item.label}
      </a>
    ))}
  </div>
</div>
