---
/**
 * SetupCard — Scanner trade setup card.
 * Ticker logo, name, price, badges, description, confirmations.
 */

interface SetupBadge {
  text: string;
  variant?: 'blue' | 'green' | 'red' | 'purple' | 'amber';
}

interface Props {
  id?: string;
  ticker: string;
  name?: string;
  price?: string;
  change?: string;
  changeColor?: string;
  badges?: SetupBadge[];
}

const badgeClassMap: Record<string, string> = {
  blue: 'badge-blue',
  green: 'badge-green',
  red: 'badge-red',
  purple: 'badge-purple',
  amber: 'badge-amber',
};

const {
  id,
  ticker,
  name,
  price,
  change,
  changeColor,
  badges = [],
} = Astro.props;
---

<div class="setup-card" id={id || `setup-${ticker}`}>
  <div class="setup-header">
    <div class="scanner-ticker-logo">{ticker.slice(0, 4)}</div>
    <div class="setup-header-info">
      <h3>{ticker}</h3>
      {name && <div class="setup-name">{name}</div>}
    </div>
    {price && (
      <div class="setup-header-price">
        <div class="price">{price}</div>
        {change && <div class="change" style={changeColor ? `color:${changeColor}` : ''}>{change}</div>}
      </div>
    )}
  </div>
  {badges.length > 0 && (
    <div class="setup-badges">
      {badges.map(b => (
        <span class={`badge ${badgeClassMap[b.variant || 'blue']}`}>{b.text}</span>
      ))}
    </div>
  )}
  <slot />
</div>
