---
/**
 * StickyNav — Compact sticky section navigation.
 * Sticks below the brand bar, highlights current section via IntersectionObserver.
 * Horizontally scrollable on mobile for 10-20 sections.
 */

interface NavItem {
  href: string;
  icon?: string;
  label: string;
  color?: string;
}

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
---

<nav class="sticky-nav" id="stickyNav">
  <div class="sticky-nav-track">
    {items.map(item => (
      <a
        href={item.href}
        class="sticky-nav-pill"
        data-section={item.href.replace('#', '')}
      >
        {item.icon && <i class={item.icon}></i>}
        <span>{item.label}</span>
      </a>
    ))}
    <div class="sticky-nav-indicator" id="navIndicator"></div>
  </div>
</nav>

<script is:inline>
(function() {
  var nav = document.getElementById('stickyNav');
  var pills = nav.querySelectorAll('.sticky-nav-pill');
  var indicator = document.getElementById('navIndicator');
  var sections = [];

  // Collect section elements
  pills.forEach(function(pill) {
    var id = pill.getAttribute('data-section');
    var el = document.getElementById(id);
    if (el) sections.push({ id: id, el: el, pill: pill });
  });

  // Smooth scroll on click
  pills.forEach(function(pill) {
    pill.addEventListener('click', function(e) {
      e.preventDefault();
      var id = this.getAttribute('data-section');
      var target = document.getElementById(id);
      if (target) {
        var offset = nav.offsetHeight + document.querySelector('.brand-bar').offsetHeight + 16;
        var top = target.getBoundingClientRect().top + window.pageYOffset - offset;
        window.scrollTo({ top: top, behavior: 'smooth' });
      }
    });
  });

  // Move indicator to active pill
  function moveIndicator(pill) {
    if (!pill || !indicator) return;
    var track = nav.querySelector('.sticky-nav-track');
    var trackRect = track.getBoundingClientRect();
    var pillRect = pill.getBoundingClientRect();
    indicator.style.width = pillRect.width + 'px';
    indicator.style.transform = 'translateX(' + (pillRect.left - trackRect.left + track.scrollLeft) + 'px)';
    indicator.style.opacity = '1';

    // Auto-scroll the track to keep active pill visible
    var pillCenter = pill.offsetLeft + pill.offsetWidth / 2;
    var trackCenter = track.clientWidth / 2;
    track.scrollTo({ left: pillCenter - trackCenter, behavior: 'smooth' });
  }

  // IntersectionObserver for scroll-spy
  var currentActive = null;
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        var match = sections.find(function(s) { return s.el === entry.target; });
        if (match) {
          if (currentActive) currentActive.pill.classList.remove('active');
          match.pill.classList.add('active');
          currentActive = match;
          moveIndicator(match.pill);
        }
      }
    });
  }, {
    rootMargin: '-20% 0px -60% 0px',
    threshold: 0
  });

  sections.forEach(function(s) { observer.observe(s.el); });

  // Set first pill active initially
  if (sections.length > 0) {
    sections[0].pill.classList.add('active');
    currentActive = sections[0];
    // Defer indicator positioning to after layout
    requestAnimationFrame(function() { moveIndicator(sections[0].pill); });
  }
})();
</script>
