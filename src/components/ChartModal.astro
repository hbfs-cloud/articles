---
/**
 * ChartModal — Universal chart overlay.
 * Opens Finviz/TradingView charts for stocks, indices, or crypto.
 * Triggered via openChartModal(symbol, label) from onclick handlers.
 */
---

<div id="chartModal" class="modal-overlay chart-modal-overlay" onclick="if(event.target===this)closeChartModal()">
  <div class="chart-modal-content">
    <div class="chart-modal-header">
      <h3 id="chartTitle"></h3>
      <button onclick="closeChartModal()" class="modal-close">&times;</button>
    </div>
    <div id="chartBody"></div>
    <div id="chartLinks" class="chart-modal-links"></div>
  </div>
</div>

<script is:inline>
var MW_CRYPTO = ['BTC-USD','ETH-USD','SOL-USD','XRP-USD','DOGE-USD','ADA-USD','AVAX-USD','DOT-USD','LINK-USD','MATIC-USD'];
var MW_INDICES = ['VIX','DXY','TNX','TYX','SPX','NDX','DJI'];

function isMWCrypto(s) { return MW_CRYPTO.indexOf(s) !== -1 || s.indexOf('-USD') !== -1; }
function isMWIndex(s) { return MW_INDICES.indexOf(s) !== -1; }

function openChartModal(symbol, label) {
  document.getElementById('chartTitle').innerHTML =
    '<i class="fa-solid fa-chart-line" style="color:#3b82f6;margin-right:0.5rem;"></i>' +
    symbol + ' \u2014 ' + (label || symbol);

  var body = document.getElementById('chartBody');
  var links = document.getElementById('chartLinks');
  var linkStyle = 'color:#3b82f6; text-decoration:none; font-size:0.85rem; font-weight:600;';

  if (isMWCrypto(symbol)) {
    var tv = symbol.replace('-USD', '');
    body.innerHTML = '<div style="height:420px;border-radius:8px;overflow:hidden;">' +
      '<iframe src="https://s.tradingview.com/widgetembed/?symbol=COINBASE:' + tv +
      'USD&interval=D&theme=dark&style=1&timezone=America/New_York&withdateranges=1&allow_symbol_change=0&save_image=0&toolbarbg=0f172a&hide_top_toolbar=0" ' +
      'style="width:100%;height:100%;border:none;"></iframe></div>';
    links.innerHTML = '<a href="https://www.tradingview.com/chart/?symbol=' + tv + 'USD" target="_blank" style="' + linkStyle + '">TradingView</a>';
  } else if (isMWIndex(symbol)) {
    var tvSym = symbol === 'VIX' ? 'CBOE:VIX' : 'TVC:' + symbol;
    body.innerHTML = '<div style="height:420px;border-radius:8px;overflow:hidden;">' +
      '<iframe src="https://s.tradingview.com/widgetembed/?symbol=' + tvSym +
      '&interval=D&theme=dark&style=1&timezone=America/New_York&withdateranges=1&allow_symbol_change=0&save_image=0&toolbarbg=0f172a" ' +
      'style="width:100%;height:100%;border:none;"></iframe></div>';
    links.innerHTML = '<a href="https://www.tradingview.com/chart/?symbol=' + tvSym + '" target="_blank" style="' + linkStyle + '">TradingView</a>';
  } else {
    body.innerHTML = '<img src="https://charts2.finviz.com/chart.ashx?t=' + symbol +
      '&ty=c&ta=1&p=d&s=l" style="width:100%;border-radius:8px;background:#1e293b;" onerror="this.style.display=\'none\'">';
    links.innerHTML = '<a href="https://finviz.com/quote.ashx?t=' + symbol + '" target="_blank" style="' + linkStyle + '">Finviz</a>' +
      '<a href="https://www.tradingview.com/chart/?symbol=' + symbol + '" target="_blank" style="' + linkStyle + '">TradingView</a>';
  }

  document.getElementById('chartModal').style.display = 'flex';
}

function closeChartModal() {
  document.getElementById('chartModal').style.display = 'none';
  document.getElementById('chartBody').innerHTML = '';
}

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeChartModal();
});
</script>
