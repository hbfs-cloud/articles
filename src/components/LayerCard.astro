---
/**
 * LayerCard — Framework layer visualization card.
 * Color-coded left border + numbered circle.
 * Variants: macro (blue), timing (purple), tactical (amber),
 *           risk (red), execution (green).
 */

interface ChecklistItem {
  text: string;
  icon?: string;
}

interface Props {
  number: number;
  title: string;
  variant?: 'macro' | 'timing' | 'tactical' | 'risk' | 'execution';
  checklist?: ChecklistItem[];
}

const {
  number,
  title,
  variant = 'macro',
  checklist = [],
} = Astro.props;
---

<div class={`layer-card layer-${variant}`}>
  <h4>
    <span class="layer-number">{number}</span>
    {title}
  </h4>
  <slot />
  {checklist.length > 0 && (
    <ul class="checklist">
      {checklist.map(item => (
        <li>
          <i class={item.icon || 'fa-solid fa-check-circle'} style="color:#16a34a;"></i>
          <span set:html={item.text} />
        </li>
      ))}
    </ul>
  )}
</div>
