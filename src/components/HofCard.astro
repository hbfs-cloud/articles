---
/**
 * HofCard — Hall of Fame / notable figure card.
 * Avatar with initials, name, alias, stats, and description.
 */

interface LegendStat {
  value: string;
  label: string;
}

interface Props {
  initials: string;
  name: string;
  alias?: string;
  avatarGradient?: string;
  stats?: LegendStat[];
}

const {
  initials,
  name,
  alias,
  avatarGradient = 'linear-gradient(135deg, #1e293b 0%, #334155 100%)',
  stats = [],
} = Astro.props;
---

<div class="hof-card">
  <div class="legend-header">
    <div class="legend-avatar" style={`background:${avatarGradient}`}>{initials}</div>
    <div>
      <div class="legend-name">{name}</div>
      {alias && <div class="legend-alias">{alias}</div>}
    </div>
  </div>
  <slot />
  {stats.length > 0 && (
    <div class="legend-stats">
      {stats.map(s => (
        <div class="legend-stat">
          <div class="stat-value">{s.value}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  )}
</div>
