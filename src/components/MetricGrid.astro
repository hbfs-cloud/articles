---
/**
 * MetricGrid — Dashboard KPI cards.
 * Used in daily dashboards, analysis headers, weekly summaries.
 */
interface Metric {
  label: string;
  value: string;
  change?: string;
  direction?: 'up' | 'down' | 'neutral';
}

interface Props {
  items: Metric[];
}

const { items } = Astro.props;
---

<div class="metric-grid">
  {items.map(m => (
    <div class="metric-card">
      <div class="metric-value">{m.value}</div>
      <div class="metric-label">{m.label}</div>
      {m.change && (
        <div class={`metric-change ${m.direction || 'neutral'}`}>{m.change}</div>
      )}
    </div>
  ))}
</div>
